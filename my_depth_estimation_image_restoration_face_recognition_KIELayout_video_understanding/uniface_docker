# =============================================================================
# uniface_docker.dockerfile
# UniFace v3.0.0 (MIT) — all-in-one face analysis toolkit.
#
# ЧТО ЭТО:
#   UniFace — единый фреймворк для face analysis: детекция, распознавание,
#   landmarks, возраст/пол/эмоции, anti-spoofing, трекинг, парсинг.
#   Работает через ONNX Runtime (CPU/GPU/Apple Silicon).
#
# ЛИЦЕНЗИЯ:
#   MIT — коммерчески чистая, включая веса AdaFace/ArcFace/MobileFace,
#   которые в UniFace распространяются под MIT [citation:12].
#
# ПОЧЕМУ UNIFACE, А НЕ SFACE/ADAFACE:
#   - SFace даёт только recognition (нужен отдельный детектор).
#   - AdaFace standalone — веса могут быть NC.
#   - UniFace — полный пайплайн с MIT на всё [citation:5].
# =============================================================================

FROM pytorch/pytorch:2.6.0-cuda12.6-cudnn9-devel

RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget libgl1 libglib2.0-0 libsm6 libxext6 libxrender-dev \
    gcc g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# UniFace ставится через pip, использует ONNX Runtime
RUN pip install --no-cache-dir uniface

# ONNX Runtime GPU для ускорения
RUN pip install --no-cache-dir onnxruntime-gpu

# Дополнительные зависимости для визуализации и работы с изображениями
RUN pip install --no-cache-dir \
    opencv-python-headless \
    matplotlib seaborn pandas scipy \
    Pillow tqdm

RUN mkdir -p /workspace/images /workspace/runs /workspace/logs /workspace/logs/plots

# =============================================================================
# ИНФЕРЕНС: Face Analysis Pipeline
# =============================================================================
COPY <<'PYTHON' /workspace/inference.py
"""
UniFace inference: детекция + распознавание + landmarks.

Использует ONNX Runtime, работает на CPU/GPU.
"""
import os, time, argparse
import cv2
import numpy as np
from uniface import RetinaFace, AdaFace

def main():
    p = argparse.ArgumentParser()
    p.add_argument("--input", required=True, help="Image or directory")
    p.add_argument("--output", default="/workspace/runs/uniface")
    p.add_argument("--log", default="/workspace/logs/uniface.log")
    args = p.parse_args()

    os.makedirs(args.output, exist_ok=True)

    with open(args.log, "a") as f:
        f.write(f"=== UniFace Inference ===\n")
        f.write(f"Timestamp: {time.strftime('%Y-%m-%d %H:%M:%S')}\n")

    # Детектор: RetinaFace или SCRFD
    detector = RetinaFace()
    # Распознаватель: AdaFace (в UniFace под MIT)
    recognizer = AdaFace()

    if os.path.isdir(args.input):
        images = sorted([os.path.join(args.input, f)
                         for f in os.listdir(args.input)
                         if f.endswith(('.jpg', '.jpeg', '.png'))])
    else:
        images = [args.input]

    for img_path in images:
        base = os.path.splitext(os.path.basename(img_path))[0]
        img = cv2.imread(img_path)
        if img is None:
            continue

        t0 = time.perf_counter()
        # Детекция лиц
        faces = detector.detect(img)
        # Извлечение эмбеддингов
        embeddings = []
        for face in faces:
            aligned = recognizer.align(img, face.landmarks)
            emb = recognizer.get_embedding(aligned)
            embeddings.append(emb)
        latency = (time.perf_counter() - t0) * 1000

        # Визуализация: bbox + landmarks
        for i, face in enumerate(faces):
            x1, y1, x2, y2 = face.bbox.astype(int)
            cv2.rectangle(img, (x1, y1), (x2, y2), (0, 255, 0), 2)
            for lm in face.landmarks:
                cv2.circle(img, (int(lm[0]), int(lm[1])), 2, (0, 0, 255), -1)
            cv2.putText(img, f"Face {i}", (x1, y1 - 5),
                       cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)

        out_path = os.path.join(args.output, base + "_faces.jpg")
        cv2.imwrite(out_path, img)

        with open(args.log, "a") as f:
            f.write(f"{base}: {len(faces)} faces, {latency:.2f} ms\n")

        print(f"{base}: {len(faces)} faces, {latency:.2f} ms")

if __name__ == "__main__":
    main()
PYTHON

# =============================================================================
# СРАВНЕНИЕ ЛИЦ (verification / identification)
# =============================================================================
COPY <<'PYTHON' /workspace/verify.py
"""
Face verification: сравнение двух лиц по эмбеддингам.
"""
import os, time, argparse
import cv2
import numpy as np
from uniface import RetinaFace, AdaFace

def cosine_similarity(a, b):
    return np.dot(a, b) / (np.linalg.norm(a) * np.linalg.norm(b))

def main():
    p = argparse.ArgumentParser()
    p.add_argument("--img1", required=True)
    p.add_argument("--img2", required=True)
    p.add_argument("--threshold", type=float, default=0.5)
    p.add_argument("--log", default="/workspace/logs/verify.log")
    args = p.parse_args()

    with open(args.log, "a") as f:
        f.write(f"=== UniFace Verification ===\n")
        f.write(f"Timestamp: {time.strftime('%Y-%m-%d %H:%M:%S')}\n")

    detector = RetinaFace()
    recognizer = AdaFace()

    def get_embedding(path):
        img = cv2.imread(path)
        faces = detector.detect(img)
        if len(faces) == 0:
            return None
        aligned = recognizer.align(img, faces[0].landmarks)
        return recognizer.get_embedding(aligned)

    emb1 = get_embedding(args.img1)
    emb2 = get_embedding(args.img2)

    if emb1 is None or emb2 is None:
        print("ERROR: Face not detected in one of the images")
        return

    sim = cosine_similarity(emb1, emb2)
    is_same = sim > args.threshold

    with open(args.log, "a") as f:
        f.write(f"Similarity: {sim:.4f}\n")
        f.write(f"Threshold: {args.threshold}\n")
        f.write(f"Same person: {is_same}\n")

    print(f"Similarity: {sim:.4f}, Same person: {is_same}")

if __name__ == "__main__":
    main()
PYTHON

ENTRYPOINT ["/bin/bash"]