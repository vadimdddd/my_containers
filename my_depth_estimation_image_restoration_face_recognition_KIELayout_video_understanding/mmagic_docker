# mmagic_docker.dockerfile
# MMagic (Apache 2.0) Ч image restoration / generation toolkit.
#
# „“ќ Ё“ќ:
#   MMagic Ч OpenMMLab тулкит дл€ restoration, generation, matting.
#   ѕоддерживает: Real-ESRGAN, ESRGAN, BasicVSR, EDVR, StyleGAN и др.
#
# ќ—ќЅ≈ЌЌќ—“№:
#   Ёто тот же образ, что Real-ESRGAN, но с полным набором конфигов MMagic.
#   ћожно выбирать разные модели через CONFIG.
#
# Ћ»÷≈Ќ«»я: Apache 2.0
# =============================================================================

FROM pytorch/pytorch:1.10.0-cuda11.3-cudnn8-devel

RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget libgl1 libglib2.0-0 libsm6 libxext6 libxrender-dev \
    gcc g++ ninja-build \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

RUN pip install --no-cache-dir \
    torchvision==0.11.0 torchaudio==0.10.0 \
    --index-url https://download.pytorch.org/whl/cu113

RUN pip install --no-cache-dir \
    mmcv-full==1.7.0 \
    -f https://download.openmmlab.com/mmcv/dist/cu113/torch1.10.0/index.html

RUN git clone -b 'v1.0.0' https://github.com/open-mmlab/mmagic.git . \
    && pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir -v -e .

RUN pip install --no-cache-dir \
    opencv-python-headless \
    matplotlib seaborn pandas scipy

RUN mkdir -p /workspace/images /workspace/runs /workspace/logs /workspace/work_dirs

COPY <<'SHELL' /workspace/inference.sh
#!/bin/bash
set -e
LOG_FILE=${LOG_FILE:-/workspace/logs/inference.log}
{
echo "=== MMagic Inference ==="
echo "Model: ${MODEL_TYPE:-real_esrgan}"
echo "Config: ${CONFIG}"
echo "---"

cd /workspace
python demo/restoration_demo.py \
    ${CONFIG} \
    ${CHECKPOINT} \
    ${INPUT_DIR} \
    ${OUTPUT_DIR} \
    --imshow=False
} 2>&1 | tee $LOG_FILE
SHELL
RUN chmod +x /workspace/inference.sh

ENTRYPOINT ["/bin/bash"]