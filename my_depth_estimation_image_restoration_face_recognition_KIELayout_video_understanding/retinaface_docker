FROM pytorch/pytorch:2.6.0-cuda12.6-cudnn9-devel

RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget libgl1 libglib2.0-0 libsm6 libxext6 libxrender-dev \
    gcc g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

RUN pip install --no-cache-dir \
    torch==2.6.0 torchvision==0.21.0 \
    --index-url https://download.pytorch.org/whl/cu126

RUN pip install --no-cache-dir \
    opencv-python-headless \
    matplotlib seaborn pandas scipy \
    Pillow

# RetinaFace PyTorch (yakhyo, MIT) [citation:4]
RUN git clone https://github.com/yakhyo/retinaface-pytorch.git . \
    && pip install --no-cache-dir -r requirements.txt

RUN mkdir -p /workspace/images /workspace/runs /workspace/logs

COPY <<'PYTHON' /workspace/inference.py
"""
RetinaFace inference: detection + 5 landmarks.
"""
import os, time, argparse
import cv2
import numpy as np

def main():
    p = argparse.ArgumentParser()
    p.add_argument("--input", required=True)
    p.add_argument("--output", default="/workspace/runs/retinaface")
    p.add_argument("--log", default="/workspace/logs/retinaface.log")
    args = p.parse_args()

    os.makedirs(args.output, exist_ok=True)

    with open(args.log, "a") as f:
        f.write(f"=== RetinaFace Inference ===\nTimestamp: {time.strftime('%Y-%m-%d %H:%M:%S')}\n")

    # «агрузка модели (см. docs репозитори€ yakhyo/retinaface-pytorch)
    # «десь упрощЄнный вариант Ч используем OpenCV DNN или PyTorch weights
    from models.retinaface import RetinaFace
    import torch

    model = RetinaFace()
    model.eval()
    if torch.cuda.is_available():
        model = model.cuda()

    if os.path.isdir(args.input):
        images = sorted([os.path.join(args.input, f)
                         for f in os.listdir(args.input)
                         if f.endswith(('.jpg', '.jpeg', '.png'))])
    else:
        images = [args.input]

    for img_path in images:
        base = os.path.splitext(os.path.basename(img_path))[0]
        img = cv2.imread(img_path)
        if img is None:
            continue

        img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
        img_tensor = torch.from_numpy(img_rgb).permute(2, 0, 1).float().unsqueeze(0)
        if torch.cuda.is_available():
            img_tensor = img_tensor.cuda()

        t0 = time.perf_counter()
        with torch.no_grad():
            detections = model(img_tensor)
        latency = (time.perf_counter() - t0) * 1000

        # –исуем
        if detections is not None:
            for det in detections[0]:
                x1, y1, x2, y2 = det[:4].cpu().numpy().astype(int)
                cv2.rectangle(img, (x1, y1), (x2, y2), (0, 255, 0), 2)

        out_path = os.path.join(args.output, base + "_retinaface.jpg")
        cv2.imwrite(out_path, img)

        with open(args.log, "a") as f:
            f.write(f"{base}: {latency:.2f} ms\n")

if __name__ == "__main__":
    main()
PYTHON

ENTRYPOINT ["/bin/bash"]