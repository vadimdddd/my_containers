# =============================================================================
# table_transformer_docker.dockerfile
# Table Transformer (MIT) — table structure recognition.
#
# ЧТО ЭТО:
#   Table Transformer (TATR) от Microsoft — detection + structure recognition
#   таблиц в документах. Лицензия MIT.
#   Доступен через HuggingFace transformers [citation:5].
#
# МОДЕЛИ:
#   microsoft/table-transformer-detection — детекция таблиц
#   microsoft/table-transformer-structure-recognition — структура (строки/столбцы)
# =============================================================================

FROM pytorch/pytorch:2.6.0-cuda12.6-cudnn9-devel

RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget libgl1 libglib2.0-0 libsm6 libxext6 libxrender-dev \
    gcc g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

RUN pip install --no-cache-dir \
    torch==2.6.0 torchvision==0.21.0 \
    --index-url https://download.pytorch.org/whl/cu126

RUN pip install --no-cache-dir \
    transformers \
    accelerate \
    opencv-python-headless \
    matplotlib seaborn pandas scipy \
    Pillow \
    timm

RUN mkdir -p /workspace/images /workspace/runs /workspace/logs

COPY <<'PYTHON' /workspace/inference.py
"""
Table Transformer inference: detection + structure recognition.
"""
import os, time, argparse
import cv2
import torch
from PIL import Image
from transformers import AutoImageProcessor, TableTransformerForObjectDetection

def main():
    p = argparse.ArgumentParser()
    p.add_argument("--input", required=True)
    p.add_argument("--output", default="/workspace/runs/tables")
    p.add_argument("--log", default="/workspace/logs/tables.log")
    args = p.parse_args()

    os.makedirs(args.output, exist_ok=True)

    with open(args.log, "a") as f:
        f.write(f"=== Table Transformer Inference ===\nTimestamp: {time.strftime('%Y-%m-%d %H:%M:%S')}\n")

    # Detection model
    det_processor = AutoImageProcessor.from_pretrained(
        "microsoft/table-transformer-detection", revision="no_timm"
    )
    det_model = TableTransformerForObjectDetection.from_pretrained(
        "microsoft/table-transformer-detection", revision="no_timm"
    ).cuda().eval()

    # Structure model
    str_processor = AutoImageProcessor.from_pretrained(
        "microsoft/table-transformer-structure-recognition", revision="no_timm"
    )
    str_model = TableTransformerForObjectDetection.from_pretrained(
        "microsoft/table-transformer-structure-recognition", revision="no_timm"
    ).cuda().eval()

    if os.path.isdir(args.input):
        images = sorted([os.path.join(args.input, f)
                         for f in os.listdir(args.input)
                         if f.endswith(('.jpg', '.jpeg', '.png'))])
    else:
        images = [args.input]

    for img_path in images:
        base = os.path.splitext(os.path.basename(img_path))[0]
        image = Image.open(img_path).convert("RGB")

        # Detection
        inputs = det_processor(images=image, return_tensors="pt").to("cuda")
        t0 = time.perf_counter()
        with torch.no_grad():
            outputs = det_model(**inputs)
        det_latency = (time.perf_counter() - t0) * 1000

        # Structure (на полном изображении)
        inputs_str = str_processor(images=image, return_tensors="pt").to("cuda")
        t0 = time.perf_counter()
        with torch.no_grad():
            outputs_str = str_model(**inputs_str)
        str_latency = (time.perf_counter() - t0) * 1000

        # Визуализация
        img = cv2.imread(img_path)
        # Здесь — упрощённо: рисуем bbox таблиц
        # Полный код парсинга структуры — в docs transformers

        cv2.imwrite(os.path.join(args.output, base + "_tables.jpg"), img)

        with open(args.log, "a") as f:
            f.write(f"{base}: det={det_latency:.2f}ms, str={str_latency:.2f}ms\n")

if __name__ == "__main__":
    main()
PYTHON

ENTRYPOINT ["/bin/bash"]