COPY <<'PYTHON' /workspace/01_train.py
"""
Detectron2 Keypoint R-CNN training.
"""
import os, time
from detectron2.engine import DefaultTrainer
from detectron2.config import get_cfg
from detectron2 import model_zoo
from detectron2.data.datasets import register_coco_instances
from detectron2.data import MetadataCatalog

COCO_DIR = os.environ.get("COCO_DIR", "/workspace/datasets/coco_kpts")
OUTPUT_DIR = os.environ.get("OUTPUT_DIR", "/workspace/output")
NUM_KEYPOINTS = int(os.environ.get("NUM_KEYPOINTS", "17"))

with open("/workspace/logs/01_train.log", "a") as f:
    f.write(f"=== Detectron2 Keypoint Training ===\nTimestamp: {time.strftime('%Y-%m-%d %H:%M:%S')}\n")
    f.write(f"Num keypoints: {NUM_KEYPOINTS}\n")

register_coco_instances("kpts_train", {},
                        os.path.join(COCO_DIR, "train", "_annotations.coco.json"),
                        os.path.join(COCO_DIR, "train"))
register_coco_instances("kpts_valid", {},
                        os.path.join(COCO_DIR, "valid", "_annotations.coco.json"),
                        os.path.join(COCO_DIR, "valid"))

# Устанавливаем metadata для keypoints
MetadataCatalog.get("kpts_train").keypoint_names = [f"kp_{i}" for i in range(NUM_KEYPOINTS)]
MetadataCatalog.get("kpts_train").keypoint_flip_map = []

cfg = get_cfg()
cfg.merge_from_file(model_zoo.get_config_file("COCO-Keypoints/keypoint_rcnn_R_50_FPN_3x.yaml"))
cfg.DATASETS.TRAIN = ("kpts_train",)
cfg.DATASETS.TEST = ("kpts_valid",)
cfg.DATALOADER.NUM_WORKERS = 2
cfg.MODEL.WEIGHTS = model_zoo.get_checkpoint_url("COCO-Keypoints/keypoint_rcnn_R_50_FPN_3x.yaml")
cfg.SOLVER.IMS_PER_BATCH = int(os.environ.get("BATCH", "2"))
cfg.SOLVER.BASE_LR = 0.00025
cfg.SOLVER.MAX_ITER = int(os.environ.get("MAX_ITER", "30000"))
cfg.MODEL.ROI_HEADS.NUM_CLASSES = 1  # ОДНА категория [citation:25]
cfg.MODEL.ROI_KEYPOINT_HEAD.NUM_KEYPOINTS = NUM_KEYPOINTS
cfg.TEST.KEYPOINT_OKS_SIGMAS = [0.05] * NUM_KEYPOINTS
cfg.OUTPUT_DIR = OUTPUT_DIR
os.makedirs(OUTPUT_DIR, exist_ok=True)

trainer = DefaultTrainer(cfg)
trainer.resume_or_load(resume=False)
trainer.train()

with open("/workspace/logs/01_train.log", "a") as f:
    f.write("Training complete.\n")
PYTHON

COPY <<'SHELL' /workspace/pipeline.sh
#!/bin/bash
set -e
MASTER_LOG=/workspace/logs/00_pipeline.log
mkdir -p /workspace/logs
log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [PIPELINE] $1" | tee -a $MASTER_LOG; }
trap 'log "FAILED at step ${CURRENT_STEP} (exit=$?)"; exit 1' ERR

log "Detectron2 Keypoint Pipeline START"
CURRENT_STEP="0/2 CONVERT"; log "STEP 0/2: Converting LabelMe > COCO Keypoints"
python /workspace/00_convert.py 2>&1 | tee -a /workspace/logs/00_convert.log

CURRENT_STEP="1/2 TRAIN"; log "STEP 1/2: Training Keypoint R-CNN"
python /workspace/01_train.py 2>&1 | tee -a /workspace/logs/01_train.log

log "Pipeline COMPLETE"
SHELL
RUN chmod +x /workspace/pipeline.sh

ENTRYPOINT ["/workspace/pipeline.sh"]