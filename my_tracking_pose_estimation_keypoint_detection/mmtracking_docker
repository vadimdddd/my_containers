COPY <<'SHELL' /workspace/01_train.sh
#!/bin/bash
set -e
LOG_FILE=${LOG_FILE:-/workspace/logs/01_train.log}
{
echo "=== MMTracking Training ==="
echo "Timestamp: $(date)"
echo "Config: ${CONFIG:-configs/mot/deepsort/deepsort_faster-rcnn_fpn_4e_mot17-private-half.py}"
echo "---"

cd /workspace/mmtracking
python tools/train.py ${CONFIG} --work-dir /workspace/work_dirs/${RUN_NAME:-mmtrack}
} 2>&1 | tee $LOG_FILE
SHELL
RUN chmod +x /workspace/01_train.sh

COPY <<'SHELL' /workspace/02_test.sh
#!/bin/bash
set -e
LOG_FILE=${LOG_FILE:-/workspace/logs/02_test.log}
{
echo "=== MMTracking Test ==="
cd /workspace/mmtracking
python tools/test.py ${CONFIG} ${CHECKPOINT} --eval bbox track
} 2>&1 | tee $LOG_FILE
SHELL
RUN chmod +x /workspace/02_test.sh

COPY <<'SHELL' /workspace/pipeline.sh
#!/bin/bash
set -e
MASTER_LOG=/workspace/logs/00_pipeline.log
mkdir -p /workspace/logs /workspace/logs/plots
log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [PIPELINE] $1" | tee -a $MASTER_LOG; }
trap 'log "FAILED at step ${CURRENT_STEP} (exit=$?)"; exit 1' ERR

log "MMTracking Pipeline START"
CURRENT_STEP="0/3 CONVERT"; log "STEP 0/3: Converting LabelMe > CocoVID"
python /workspace/00_convert.py 2>&1 | tee -a /workspace/logs/00_convert.log

CURRENT_STEP="1/3 TRAIN"; log "STEP 1/3: Training"
bash /workspace/01_train.sh

CURRENT_STEP="2/3 TEST"; log "STEP 2/3: Testing"
bash /workspace/02_test.sh

log "Pipeline COMPLETE"
SHELL
RUN chmod +x /workspace/pipeline.sh

ENTRYPOINT ["/workspace/pipeline.sh"]