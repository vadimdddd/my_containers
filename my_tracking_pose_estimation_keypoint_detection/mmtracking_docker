COPY <<'PYTHON' /workspace/00_convert.py
"""
LabelMe JSON > CocoVID формат дл€ MMTracking.

CocoVID Ч это COCO с добавлением video_id в images и annotations.
"""
import os, sys, glob, json, shutil
import cv2
import numpy as np
from sklearn.model_selection import train_test_split

DATASETS_DIR = os.environ.get("DATASETS_DIR", "/workspace/datasets")
OUT_DIR = os.environ.get("MMTRACK_DATA_DIR", "/workspace/mmtracking/data/custom_mot")
OBJ_NAMES_FILE = os.environ.get("OBJ_NAMES_FILE", "obj.names")
SPLIT_SIZE = float(os.environ.get("SPLIT_SIZE", "0.2"))
RANDOM_STATE = int(os.environ.get("RANDOM_STATE", "42"))

def find_video_folders(root):
    """»щем папки с последовательными кадрами (видео-подобные)."""
    folders = []
    for dp, dn, fn in os.walk(root):
        if any(f.endswith('.json') for f in fn):
            folders.append(dp)
    return sorted(folders)

def make_coco_vid(video_folders, label_list, out_path, img_dir):
    """—оздаЄт CocoVID JSON из последовательности кадров."""
    images, annotations, videos = [], [], []
    video_id = 0
    ann_id = 0
    img_id = 0

    for vid_folder in video_folders:
        json_files = sorted(glob.glob(os.path.join(vid_folder, '*.json')))
        if len(json_files) < 2:
            continue

        video_id += 1
        videos.append({"id": video_id, "name": os.path.basename(vid_folder)})

        for frame_idx, jp in enumerate(json_files):
            base = os.path.splitext(os.path.basename(jp))[0]
            jpg = os.path.join(vid_folder, base + '.jpg')
            if not os.path.exists(jpg):
                continue

            img_out = os.path.join(img_dir, base + '.jpg')
            shutil.copy2(jpg, img_out)

            img = cv2.imread(img_out)
            if img is None:
                continue
            h, w = img.shape[:2]

            images.append({
                "id": img_id,
                "file_name": base + '.jpg',
                "width": w, "height": h,
                "video_id": video_id,
                "frame_id": frame_idx,
            })

            with open(jp, encoding='utf-8') as f:
                data = json.load(f)

            for shape in data.get('shapes', []):
                label = shape['label']
                if label not in label_list:
                    continue
                pts = np.array(shape['points']).astype(int)
                x_min, y_min = np.min(pts, axis=0)
                x_max, y_max = np.max(pts, axis=0)
                x_min, y_min = max(0, x_min), max(0, y_min)
                x_max, y_max = min(w, x_max), min(h, y_max)
                if x_max <= x_min or y_max <= y_min:
                    continue
                annotations.append({
                    "id": ann_id,
                    "image_id": img_id,
                    "category_id": label_list.index(label) + 1,
                    "bbox": [int(x_min), int(y_min), int(x_max - x_min), int(y_max - y_min)],
                    "area": int((x_max - x_min) * (y_max - y_min)),
                    "iscrowd": 0,
                    "instance_id": ann_id,  # дл€ MOT
                    "video_id": video_id,
                })
                ann_id += 1
            img_id += 1

    categories = [{"id": i + 1, "name": name} for i, name in enumerate(label_list)]
    coco_vid = {"images": images, "annotations": annotations,
                "categories": categories, "videos": videos}

    with open(out_path, 'w') as f:
        json.dump(coco_vid, f)
    print(f"[OK] {out_path}: {len(images)} images, {len(annotations)} annotations, {len(videos)} videos")

def main():
    for sub in ['train', 'val']:
        os.makedirs(os.path.join(OUT_DIR, 'images', sub), exist_ok=True)
        os.makedirs(os.path.join(OUT_DIR, 'annotations'), exist_ok=True)

    obj_path = os.path.join(DATASETS_DIR, OBJ_NAMES_FILE)
    with open(obj_path) as f:
        LABEL_LIST = [l.strip() for l in f if l.strip()]

    video_folders = find_video_folders(DATASETS_DIR)
    train_folders, val_folders = train_test_split(
        video_folders, test_size=SPLIT_SIZE, random_state=RANDOM_STATE
    )

    make_coco_vid(train_folders, LABEL_LIST,
                  os.path.join(OUT_DIR, 'annotations', 'train.json'),
                  os.path.join(OUT_DIR, 'images', 'train'))
    make_coco_vid(val_folders, LABEL_LIST,
                  os.path.join(OUT_DIR, 'annotations', 'val.json'),
                  os.path.join(OUT_DIR, 'images', 'val'))

if __name__ == '__main__':
    main()
PYTHON

