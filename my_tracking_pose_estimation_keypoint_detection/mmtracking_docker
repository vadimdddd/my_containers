FROM pytorch/pytorch:1.10.0-cuda11.3-cudnn8-devel

RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget libgl1 libglib2.0-0 libsm6 libxext6 libxrender-dev \
    gcc g++ ninja-build ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

RUN pip install --no-cache-dir \
    torchvision==0.11.0 torchaudio==0.10.0 \
    --index-url https://download.pytorch.org/whl/cu113

# mmcv-full 1.7.0 (совместим с mmdet 2.27.0 и mmtrack 0.14.0) [citation:2][citation:17]
RUN pip install --no-cache-dir \
    mmcv-full==1.7.0 \
    -f https://download.openmmlab.com/mmcv/dist/cu113/torch1.10.0/index.html

# MMDetection 2.27.0 (зависимость MMTracking)
RUN pip install --no-cache-dir mmdet==2.27.0

# MMTracking 0.14.0
RUN git clone -b 'v0.14.0' https://github.com/open-mmlab/mmtracking.git . \
    && pip install --no-cache-dir -r requirements/build.txt \
    && pip install --no-cache-dir -v -e .

# ƒополнительные зависимости
RUN pip install --no-cache-dir \
    opencv-python-headless \
    matplotlib seaborn pandas scipy \
    tqdm

RUN mkdir -p /workspace/datasets /workspace/runs /workspace/logs /workspace/logs/plots \
    /workspace/mmtracking/data /workspace/work_dirs

