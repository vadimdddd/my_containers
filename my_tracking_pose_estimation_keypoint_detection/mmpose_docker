COPY <<'PYTHON' /workspace/00_convert.py
"""
LabelMe JSON > COCO format дл€ MMPose.

‘ќ–ћј“ COCO Keypoints:
  annotations[].keypoints = [x1, y1, v1, x2, y2, v2, ...]
  где v = 0 (не размечено), 1 (размечено, не видно), 2 (видимо)
"""
import os, sys, glob, json, shutil
import cv2
import numpy as np
from sklearn.model_selection import train_test_split

DATASETS_DIR = os.environ.get("DATASETS_DIR", "/workspace/datasets")
OUT_DIR = os.environ.get("MMPOSE_DATA_DIR", "/workspace/mmpose/data/custom_pose")
OBJ_NAMES_FILE = os.environ.get("OBJ_NAMES_FILE", "obj.names")
SPLIT_SIZE = float(os.environ.get("SPLIT_SIZE", "0.2"))
RANDOM_STATE = int(os.environ.get("RANDOM_STATE", "42"))
NUM_KEYPOINTS = int(os.environ.get("NUM_KEYPOINTS", "17"))

def convert_to_coco(json_files, label_list, out_path, img_dir):
    images, annotations = [], []
    ann_id = 0
    img_id = 0

    for jp in json_files:
        base = os.path.splitext(os.path.basename(jp))[0]
        src_dir = os.path.dirname(jp)
        jpg = os.path.join(src_dir, base + '.jpg')
        if not os.path.exists(jpg):
            continue

        img_out = os.path.join(img_dir, base + '.jpg')
        shutil.copy2(jpg, img_out)
        img = cv2.imread(img_out)
        if img is None:
            continue
        h, w = img.shape[:2]

        images.append({"id": img_id, "file_name": base + '.jpg',
                       "width": w, "height": h})

        with open(jp, encoding='utf-8') as f:
            data = json.load(f)

        for shape in data.get('shapes', []):
            if shape['label'] not in label_list:
                continue
            # ƒл€ keypoints: shape должен быть точкой (point), не полигоном
            pts = shape['points']
            if len(pts) != NUM_KEYPOINTS:
                continue

            # keypoints формат: [x1, y1, v1, x2, y2, v2, ...]
            kpts_flat = []
            for pt in pts:
                kpts_flat.extend([pt[0], pt[1], 2])  # v=2 (visible)

            # bbox вокруг всех keypoints
            xs = [p[0] for p in pts]
            ys = [p[1] for p in pts]
            x_min, y_min = max(0, min(xs)), max(0, min(ys))
            x_max, y_max = min(w, max(xs)), min(h, max(ys))
            bw, bh = x_max - x_min, y_max - y_min

            annotations.append({
                "id": ann_id,
                "image_id": img_id,
                "category_id": 1,  # person
                "keypoints": kpts_flat,
                "num_keypoints": NUM_KEYPOINTS,
                "bbox": [int(x_min), int(y_min), int(bw), int(bh)],
                "area": int(bw * bh),
                "iscrowd": 0,
            })
            ann_id += 1
        img_id += 1

    categories = [{"id": 1, "name": "person",
                   "keypoints": [f"kp_{i}" for i in range(NUM_KEYPOINTS)],
                   "skeleton": []}]
    coco = {"images": images, "annotations": annotations, "categories": categories}
    with open(out_path, 'w') as f:
        json.dump(coco, f)
    print(f"[OK] {out_path}: {len(images)} images, {len(annotations)} annotations")

def main():
    for sub in ['train', 'val']:
        os.makedirs(os.path.join(OUT_DIR, 'images', sub), exist_ok=True)
        os.makedirs(os.path.join(OUT_DIR, 'annotations'), exist_ok=True)

    obj_path = os.path.join(DATASETS_DIR, OBJ_NAMES_FILE)
    with open(obj_path) as f:
        LABEL_LIST = [l.strip() for l in f if l.strip()]

    all_json = []
    for dp, dn, fn in os.walk(DATASETS_DIR):
        all_json.extend(sorted(glob.glob(os.path.join(dp, '*.json'))))

    train_json, val_json = train_test_split(all_json, test_size=SPLIT_SIZE,
                                              random_state=RANDOM_STATE)

    convert_to_coco(train_json, LABEL_LIST,
                    os.path.join(OUT_DIR, 'annotations', 'train.json'),
                    os.path.join(OUT_DIR, 'images', 'train'))
    convert_to_coco(val_json, LABEL_LIST,
                    os.path.join(OUT_DIR, 'annotations', 'val.json'),
                    os.path.join(OUT_DIR, 'images', 'val'))

if __name__ == '__main__':
    main()
PYTHON

