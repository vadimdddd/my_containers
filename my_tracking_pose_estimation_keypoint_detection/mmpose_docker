FROM pytorch/pytorch:1.10.0-cuda11.3-cudnn8-devel

RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget libgl1 libglib2.0-0 libsm6 libxext6 libxrender-dev \
    gcc g++ ninja-build ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

RUN pip install --no-cache-dir \
    torchvision==0.11.0 torchaudio==0.10.0 \
    --index-url https://download.pytorch.org/whl/cu113

RUN pip install --no-cache-dir \
    mmcv-full==1.7.0 \
    -f https://download.openmmlab.com/mmcv/dist/cu113/torch1.10.0/index.html

# MMPose 0.29.0
RUN git clone -b 'v0.29.0' https://github.com/open-mmlab/mmpose.git . \
    && pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir -v -e .

# xtcocotools (часта€ проблема при установке) [citation:6]
RUN pip install --no-cache-dir xtcocotools

RUN pip install --no-cache-dir \
    opencv-python-headless \
    matplotlib seaborn pandas scipy \
    tqdm

RUN mkdir -p /workspace/datasets /workspace/runs /workspace/logs /workspace/logs/plots \
    /workspace/mmpose/data /workspace/work_dirs

