COPY <<'SHELL' /workspace/01_train.sh
#!/bin/bash
set -e
LOG_FILE=${LOG_FILE:-/workspace/logs/01_train.log}
{
echo "=== MMPose Training ==="
echo "Timestamp: $(date)"
echo "Config: ${CONFIG:-configs/body_2d_keypoint/topdown_heatmap/coco/td-hm_hrnet-w32_8xb64-210e_coco-256x192.py}"
echo "---"

cd /workspace/mmpose
python tools/train.py ${CONFIG} --work-dir /workspace/work_dirs/${RUN_NAME:-mmpose}
} 2>&1 | tee $LOG_FILE
SHELL
RUN chmod +x /workspace/01_train.sh

COPY <<'SHELL' /workspace/02_test.sh
#!/bin/bash
set -e
LOG_FILE=${LOG_FILE:-/workspace/logs/02_test.log}
{
echo "=== MMPose Test ==="
cd /workspace/mmpose
python tools/test.py ${CONFIG} ${CHECKPOINT} --eval mAP
} 2>&1 | tee $LOG_FILE
