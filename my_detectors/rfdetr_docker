COPY <<'PYTHON' /workspace/01_train.py
import argparse, os, time
import torch
from rfdetr import RFDETRBase, RFDETRMedium, RFDETRLarge

def main():
    p = argparse.ArgumentParser()
    p.add_argument("--dataset", default=os.environ["DATASET_DIR"])
    p.add_argument("--model", default=os.environ.get("MODEL_SIZE", "medium"),
                   choices=["base", "medium", "large"])
    p.add_argument("--epochs", type=int, default=int(os.environ.get("EPOCHS", 50)))
    p.add_argument("--batch", type=int, default=int(os.environ.get("BATCH", 4)))
    p.add_argument("--output", default=os.environ.get("OUTPUT_DIR", "/workspace/runs/rfdetr"))
    p.add_argument("--log", default="/workspace/logs/01_train.log")
    args = p.parse_args()

    with open(args.log, "a") as f:
        f.write(f"=== RF-DETR Training ===\n")
        f.write(f"Timestamp: {time.strftime('%Y-%m-%d %H:%M:%S')}\n")
        f.write(f"PyTorch: {torch.__version__}, CUDA: {torch.version.cuda}\n")
        f.write(f"Dataset: {args.dataset}\nModel: {args.model}\n---\n")

    model_cls = {"base": RFDETRBase, "medium": RFDETRMedium, "large": RFDETRLarge}[args.model]
    model = model_cls()
    model.train(dataset_dir=args.dataset, epochs=args.epochs,
                batch_size=args.batch, output_dir=args.output)

    with open(args.log, "a") as f:
        f.write(f"Training complete. Weights: {args.output}\n")

if __name__ == "__main__":
    main()
PYTHON

