COPY <<'PYTHON' /workspace/02_test_pth.py
import os, time, pickle
from rfdetr import RFDETRBase, RFDETRMedium, RFDETRLarge
from pycocotools.coco import COCO
from pycocotools.cocoeval import COCOeval
from pathlib import Path

def main():
    weights = os.environ["TRAINED_WEIGHTS"]
    dataset = os.environ["TEST_ANNOTATIONS"]
    images = os.environ["TEST_IMAGES"]
    model_size = os.environ.get("MODEL_SIZE", "medium")
    log = "/workspace/logs/02_test_pth.log"

    with open(log, "a") as f:
        f.write(f"=== RF-DETR Test (PTH) ===\n")
        f.write(f"Timestamp: {time.strftime('%Y-%m-%d %H:%M:%S')}\n")
        f.write(f"Weights: {weights}\n---\n")

    model_cls = {"base": RFDETRBase, "medium": RFDETRMedium, "large": RFDETRLarge}[model_size]
    model = model_cls(pretrain_weights=weights)

    coco = COCO(dataset)
    results, latencies = [], []
    for img_id in coco.getImgIds():
        info = coco.loadImgs(img_id)[0]
        path = str(Path(images) / info["file_name"])
        t0 = time.perf_counter()
        dets = model.predict(path, threshold=0.5)
        t1 = time.perf_counter()
        latencies.append((t1 - t0) * 1000)
        for i in range(len(dets.xyxy)):
            x1, y1, x2, y2 = dets.xyxy[i].tolist()
            results.append({
                "image_id": img_id,
                "category_id": int(dets.class_id[i]) + 1,
                "bbox": [x1, y1, x2 - x1, y2 - y1],
                "score": float(dets.confidence[i]),
            })

    coco_dt = coco.loadRes(results)
    ev = COCOeval(coco, coco_dt, "bbox")
    ev.evaluate(); ev.accumulate(); ev.summarize()

    with open(log, "a") as f:
        f.write(f"mAP@0.5: {ev.stats[1]:.4f}\n")
        f.write(f"mAP@0.5:0.95: {ev.stats[0]:.4f}\n")
        f.write(f"Avg latency: {sum(latencies)/len(latencies):.2f} ms\n")
        f.write("PTH test complete.\n")

if __name__ == "__main__":
    main()
PYTHON

