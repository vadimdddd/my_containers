# =============================================================================
# rfdetr_docker.dockerfile
# RF-DETR (Apache 2.0) — полностью автоматический пайплайн:
#   train > test .pth > export .onnx > test .onnx > plots
#
# ЗАЧЕМ ЭТОТ ОБРАЗ:
#   Один `docker run` выполняет все 5 стадий и даёт готовую .onnx + 6 логов
#   + 4 графика.
#
# ЛИЦЕНЗИЯ:
#   Apache 2.0 на код и веса. Можно в закрытых коммерческих продуктах.
#
# СОВМЕСТИМОСТЬ ВЕРСИЙ:
#   pyproject.toml требует torch>=2.2.0. Используем PyTorch 2.6.0 + CUDA 12.6.
# =============================================================================

# -----------------------------------------------------------------------------
# БАЗОВЫЙ ОБРАЗ: PyTorch 2.6.0 + CUDA 12.6 + cuDNN 9 (devel)
#
# ПОЧЕМУ devel: pycocotools содержит C-расширения — нужен nvcc.
# ПОЧЕМУ 2.6.0: версия из примеров установки, стабильно работает с rfdetr.
# -----------------------------------------------------------------------------
FROM pytorch/pytorch:2.6.0-cuda12.6-cudnn9-devel

# -----------------------------------------------------------------------------
# СИСТЕМНЫЕ ЗАВИСИМОСТИ
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget libgl1 libglib2.0-0 libsm6 libxext6 libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# -----------------------------------------------------------------------------
# ФИКСАЦИЯ TORCH/TORCHVISION ПОД CUDA 12.6
#   Явная установка гарантирует GPU-сборку, а не CPU.
# -----------------------------------------------------------------------------
RUN pip install --no-cache-dir \
    torch==2.6.0 torchvision==0.21.0 torchaudio==2.6.0 \
    --index-url https://download.pytorch.org/whl/cu126

# -----------------------------------------------------------------------------
# УСТАНОВКА RF-DETR
#   rfdetr[onnx] — фреймворк + ONNX-экспорт. Содержит RFDETRBase / Medium / Large,
#   автоматически скачивающие предобученные веса COCO при первом запуске.
#   albumentations, supervision, pycocotools — CV-утилиты.
#   matplotlib, seaborn, pandas — графики.
# -----------------------------------------------------------------------------
RUN pip install --no-cache-dir \
    "rfdetr[onnx]" \
    albumentations supervision pycocotools wandb \
    opencv-python-headless \
    matplotlib seaborn pandas scipy

RUN mkdir -p /workspace/datasets /workspace/runs /workspace/logs /workspace/logs/plots

