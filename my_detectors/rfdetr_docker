COPY <<'SHELL' /workspace/pipeline.sh
#!/bin/bash
set -e

MASTER_LOG=/workspace/logs/00_pipeline.log
mkdir -p /workspace/logs /workspace/logs/plots

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [PIPELINE] $1" | tee -a $MASTER_LOG
}

trap 'log "FAILED at step ${CURRENT_STEP} (exit=$?)"; exit 1' ERR

log "=========================================="
log "RF-DETR Automated Pipeline START"
log "=========================================="

if [ -z "${DATASET_DIR}" ]; then
    log "ERROR: DATASET_DIR is not set"
    exit 1
fi

RUN_NAME=${RUN_NAME:-rfdetr}
TRAINED_WEIGHTS=${TRAINED_WEIGHTS:-/workspace/runs/${RUN_NAME}/best.pth}
ONNX_OUTPUT=${ONNX_OUTPUT:-/workspace/runs/${RUN_NAME}_onnx}
ONNX_PATH=${ONNX_PATH:-${ONNX_OUTPUT}/inference_model.onnx}
TEST_ANNOTATIONS=${TEST_ANNOTATIONS:-${DATASET_DIR}/test/_annotations.coco.json}
TEST_IMAGES=${TEST_IMAGES:-${DATASET_DIR}/test}

export RUN_NAME TRAINED_WEIGHTS ONNX_OUTPUT ONNX_PATH TEST_ANNOTATIONS TEST_IMAGES

log "Config: RUN_NAME=$RUN_NAME, MODEL_SIZE=${MODEL_SIZE:-medium}, EPOCHS=${EPOCHS:-50}, BATCH=${BATCH:-4}"
log "Dataset: $DATASET_DIR"
log "Expected ONNX: $ONNX_PATH"
log ""

CURRENT_STEP="1/5 TRAIN"
log "STEP 1/5: Training started > logs/01_train.log"
START=$(date +%s)
python /workspace/01_train.py
END=$(date +%s)
log "STEP 1/5: Training finished in $((END-START))s"
log "  > Generating training curves..."
PLOT_MODE=train python /workspace/05_plots.py 2>&1 | tee -a $MASTER_LOG
log ""

CURRENT_STEP="2/5 TEST PTH"
log "STEP 2/5: Testing .pth started > logs/02_test_pth.log"
START=$(date +%s)
python /workspace/02_test_pth.py
END=$(date +%s)
log "STEP 2/5: Testing .pth finished in $((END-START))s"
log ""

CURRENT_STEP="3/5 EXPORT ONNX"
log "STEP 3/5: Exporting to ONNX started > logs/03_export.log"
START=$(date +%s)
python /workspace/03_export_onnx.py
END=$(date +%s)
log "STEP 3/5: Export finished in $((END-START))s"

if [ ! -f "${ONNX_PATH}" ]; then
    log "ERROR: ONNX file not found at ${ONNX_PATH}"
    exit 1
fi
log "  ? ONNX created: ${ONNX_PATH}"
log ""

CURRENT_STEP="4/5 TEST ONNX"
log "STEP 4/5: Testing .onnx started > logs/04_test_onnx.log"
START=$(date +%s)
python /workspace/04_test_onnx.py
END=$(date +%s)
log "STEP 4/5: Testing .onnx finished in $((END-START))s"
log ""

CURRENT_STEP="5/5 PLOTS"
log "STEP 5/5: Generating PR curves + confusion matrix + confidence profile..."
START=$(date +%s)
python /workspace/05_plots.py 2>&1 | tee -a $MASTER_LOG
END=$(date +%s)
log "STEP 5/5: Plots finished in $((END-START))s"
log "  > Plots: /workspace/logs/plots/"
log ""

log "=========================================="
log "Pipeline COMPLETE"
log "Final ONNX: ${ONNX_PATH}"
log "Logs: /workspace/logs/"
log "Plots: /workspace/logs/plots/"
log "=========================================="
SHELL
RUN chmod +x /workspace/pipeline.sh

ENTRYPOINT ["/workspace/pipeline.sh"]