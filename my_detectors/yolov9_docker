COPY <<'PYTHON' /workspace/05_plots.py
import os, csv, pickle
import numpy as np
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
from pathlib import Path

PLOTS_DIR = "/workspace/logs/plots"
os.makedirs(PLOTS_DIR, exist_ok=True)


def plot_training_curves(results_csv):
    if not Path(results_csv).exists():
        print(f"[SKIP] {results_csv} not found")
        return
    rows = []
    with open(results_csv) as f:
        reader = csv.DictReader(f)
        for row in reader:
            rows.append({k.strip(): v for k, v in row.items()})
    if not rows:
        return
    epochs = [int(r.get("epoch", i)) for i, r in enumerate(rows)]

    def get(col):
        try:
            return [float(r.get(col, 0)) for r in rows]
        except (ValueError, TypeError):
            return None

    fig, axes = plt.subplots(2, 3, figsize=(18, 10))
    fig.suptitle("YOLOv9 Training Curves", fontsize=16, fontweight="bold")
    plots = [
        ("train/box_loss", "Train Box Loss", "#E74C3C"),
        ("train/cls_loss", "Train Cls Loss", "#E67E22"),
        ("val/box_loss", "Val Box Loss", "#F39C12"),
        ("metrics/mAP50", "Val mAP@0.5", "#2ECC71"),
        ("metrics/mAP50-95", "Val mAP@0.5:0.95", "#27AE60"),
        ("metrics/precision", "Val Precision", "#3498DB"),
    ]
    for ax, (col, title, color) in zip(axes.flat, plots):
        vals = get(col)
        if vals:
            ax.plot(epochs, vals, color=color, linewidth=1.5)
            ax.set_title(title)
            ax.set_xlabel("Epoch")
            ax.grid(alpha=0.3)
        else:
            ax.text(0.5, 0.5, f"{col}\nnot found", ha="center", va="center")
            ax.set_title(title)
    plt.tight_layout()
    out = f"{PLOTS_DIR}/01_training_curves.png"
    plt.savefig(out, dpi=150)
    plt.close()
    print(f"[OK] {out}")


def plot_pr_curves(coco_eval, class_names=None):
    precision = coco_eval.eval["precision"]
    recall = coco_eval.eval["recall"]
    p = precision[:, :, 0, -1]
    r = recall[:, 0, -1]
    K = p.shape[1]
    if class_names is None:
        class_names = [f"class_{i}" for i in range(K)]

    fig, ax = plt.subplots(figsize=(10, 8))
    for k in range(K):
        if r[k] > 0 or p[k].max() > 0:
            auc = np.trapz(p[k], r[k])
            ax.plot(r[k], p[k], label=f"{class_names[k]} (AP={auc:.3f})", linewidth=1.5)
    ax.set_xlabel("Recall")
    ax.set_ylabel("Precision")
    ax.set_title("Precision-Recall Curves (IoU=0.5) — AUC-PR = AP")
    ax.set_xlim(0, 1); ax.set_ylim(0, 1.05)
    ax.legend(loc="lower left", fontsize=8)
    ax.grid(alpha=0.3)
    out = f"{PLOTS_DIR}/02_pr_curves.png"
    plt.savefig(out, dpi=150)
    plt.close()
    print(f"[OK] {out}")


def plot_confusion_matrix(coco, results, class_names):
    try:
        import supervision as sv
        preds = sv.Detections.from_coco_annotations(results)
        gt_list = []
        for img_id in coco.getImgIds():
            ann_ids = coco.getAnnIds(imgIds=img_id)
            anns = coco.loadAnns(ann_ids)
            for ann in anns:
                gt_list.append({
                    "image_id": img_id,
                    "category_id": ann["category_id"],
                    "bbox": ann["bbox"],
                })
        targets = sv.Detections.from_coco_annotations(gt_list)
        cm = sv.ConfusionMatrix.from_detections(
            predictions=preds, targets=targets, classes=class_names
        )
        cm.plot()
        out = f"{PLOTS_DIR}/03_confusion_matrix.png"
        plt.savefig(out, dpi=150, bbox_inches="tight")
        plt.close()
        print(f"[OK] {out}")
    except Exception as e:
        print(f"[SKIP] Confusion matrix: {e}")


def plot_confidence_profile(results, coco, class_names):
    if not results:
        return
    scores = np.array([r["score"] for r in results])
    thresholds = np.linspace(0.01, 0.99, 50)
    precisions, recalls, f1s = [], [], []
    n_gt = sum(len(coco.getAnnIds(imgIds=i)) for i in coco.getImgIds())

    for t in thresholds:
        mask = scores >= t
        tp = mask.sum()
        fp = (~mask).sum()
        fn = max(0, n_gt - tp)
        p = tp / (tp + fp) if (tp + fp) > 0 else 0
        r = tp / (tp + fn) if (tp + fn) > 0 else 0
        f1 = 2 * p * r / (p + r) if (p + r) > 0 else 0
        precisions.append(p); recalls.append(r); f1s.append(f1)

    fig, ax = plt.subplots(figsize=(10, 6))
    ax.plot(thresholds, precisions, label="Precision", color="#3498DB")
    ax.plot(thresholds, recalls, label="Recall", color="#2ECC71")
    ax.plot(thresholds, f1s, label="F1", color="#E74C3C")
    best_t = thresholds[np.argmax(f1s)]
    ax.axvline(best_t, linestyle="--", color="gray", alpha=0.7,
               label=f"F1-optimal: {best_t:.2f}")
    ax.set_xlabel("Confidence Threshold")
    ax.set_ylabel("Metric Value")
    ax.set_title("Confidence Profile")
    ax.legend(); ax.grid(alpha=0.3)
    out = f"{PLOTS_DIR}/04_confidence_profile.png"
    plt.savefig(out, dpi=150)
    plt.close()
    print(f"[OK] {out}")


if __name__ == "__main__":
    mode = os.environ.get("PLOT_MODE", "test")
    if mode == "train":
        results_csv = os.environ.get(
            "RESULTS_CSV",
            f"/workspace/runs/train/{os.environ.get('RUN_NAME', 'yolov9-custom')}/results.csv",
        )
        plot_training_curves(results_csv)
    else:
        pkl = Path(f"{PLOTS_DIR}/coco_eval.pkl")
        if pkl.exists():
            with open(pkl, "rb") as f:
                data = pickle.load(f)
            plot_pr_curves(data["coco_eval"], data.get("class_names"))
            from pycocotools.coco import COCO
            coco = COCO(os.environ["TEST_ANNOTATIONS"])
            plot_confusion_matrix(coco, data["results"], data.get("class_names"))
            plot_confidence_profile(data["results"], coco, data.get("class_names"))
        else:
            print("[SKIP] coco_eval.pkl not found")
PYTHON

