# =============================================================================
# yolov9_docker.dockerfile
# YOLOv9 (MIT-лицензия) — полностью автоматический пайплайн:
#   train > test .pth > export .onnx > test .onnx > plots
#
# ЗАЧЕМ ЭТОТ ОБРАЗ:
#   Один `docker run` выполняет все 5 стадий и на выходе даёт готовую .onnx
#   модель + 6 логов (мастер-лог + 5 логов по стадиям) + 4 графика.
#
# ЛИЦЕНЗИЯ:
#   MIT-сборка MultimediaTechLab/YOLO (не AGPL Ultralytics).
#   Веса yolov9-*.pt из релизов WongKinYiu/yolov9 — отдельный артефакт,
#   не подпадает под AGPL. Можно использовать в закрытых продуктах.
#
# СОВМЕСТИМОСТЬ ВЕРСИЙ (критично!):
#   Код YOLOv9 жёстко завязан на torchvision.ops.nms из 0.11.0 и
#   torch.cuda.amp.GradScaler из torch 1.10.0. Более новые версии ломают
#   train_dual.py / val_dual.py. Поэтому PyTorch 1.10.0 + CUDA 11.3.
# =============================================================================

# -----------------------------------------------------------------------------
# БАЗОВЫЙ ОБРАЗ: PyTorch 1.10.0 + CUDA 11.3 + cuDNN 8 (devel)
#
# ПОЧЕМУ devel: содержит nvcc и заголовки CUDA — нужны для сборки
#               C-расширений (pycocotools).
# ПОЧЕМУ 1.10.0: единственная версия, совместимая с кодом YOLOv9.
# -----------------------------------------------------------------------------
FROM pytorch/pytorch:1.10.0-cuda11.3-cudnn8-devel

# -----------------------------------------------------------------------------
# СИСТЕМНЫЕ ЗАВИСИМОСТИ
#   git          — для git clone репозитория YOLO
#   wget         — для скачивания предобученных весов
#   libgl1       — OpenCV требует libGL.so.1
#   libglib2.0-0 — OpenCV требует libgthread-2.0.so.0
#   libsm6, libxext6, libxrender-dev — X11-библиотеки для OpenCV
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget libgl1 libglib2.0-0 libsm6 libxext6 libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# РАБОЧАЯ ДИРЕКТОРИЯ
#   /workspace/datasets — датасет (монтируется с хоста)
#   /workspace/runs     — чекпоинты, ONNX, результаты (монтируется)
#   /workspace/logs     — логи и графики (монтируется)
# -----------------------------------------------------------------------------
WORKDIR /workspace

# -----------------------------------------------------------------------------
# ФИКСАЦИЯ TORCHVISION
#   Без torchvision не работают torchvision.ops.nms и box_iou.
#   0.11.0 — единственная версия, совместимая с torch 1.10.0.
#   --index-url cu113 — чтобы pip поставил GPU-сборку, а не CPU.
# -----------------------------------------------------------------------------
RUN pip install --no-cache-dir \
    torchvision==0.11.0 torchaudio==0.10.0 \
    --index-url https://download.pytorch.org/whl/cu113

# -----------------------------------------------------------------------------
# КЛОНИРОВАНИЕ MIT-РЕПОЗИТОРИЯ + ЗАВИСИМОСТИ
#   MultimediaTechLab/YOLO — MIT-сборка YOLOv9. Содержит train_dual.py,
#   val_dual.py, export.py, models/ с YAML-конфигами архитектур.
#   requirements.txt — PyYAML, tqdm, matplotlib, seaborn, pandas, scipy и др.
# -----------------------------------------------------------------------------
RUN git clone https://github.com/MultimediaTechLab/YOLO.git . \
    && pip install --no-cache-dir -r requirements.txt

# -----------------------------------------------------------------------------
# ДОПОЛНИТЕЛЬНЫЕ ЗАВИСИМОСТИ ДЛЯ ТЕСТА, ЭКСПОРТА И ГРАФИКОВ
#   onnx, onnxsim — экспорт и упрощение ONNX-графа
#   onnxruntime   — инференс ONNX
#   pycocotools   — COCOeval для mAP и PR-кривых
#   supervision   — confusion matrix, утилиты
#   opencv-python-headless — OpenCV без GUI
#   albumentations — аугментации
#   matplotlib, seaborn, pandas, scipy — графики и парсинг
# -----------------------------------------------------------------------------
RUN pip install --no-cache-dir \
    onnx onnxruntime onnxsim \
    pycocotools \
    supervision \
    opencv-python-headless \
    albumentations \
    matplotlib seaborn pandas scipy

# -----------------------------------------------------------------------------
# СКАЧИВАНИЕ ПРЕДОБУЧЕННЫХ ВЕСОВ COCO
#   Стартовая точка для файн-тюнинга. || true — не падаем, если GitHub недоступен.
# -----------------------------------------------------------------------------
RUN mkdir -p /workspace/weights && \
    wget -q https://github.com/WongKinYiu/yolov9/releases/download/v0.1/yolov9-c.pt \
    -O /workspace/weights/yolov9-c.pt && \
    wget -q https://github.com/WongKinYiu/yolov9/releases/download/v0.1/yolov9-m.pt \
    -O /workspace/weights/yolov9-m.pt || true

# -----------------------------------------------------------------------------
# ДИРЕКТОРИИ ДЛЯ МОНТИРОВАНИЯ
# -----------------------------------------------------------------------------
RUN mkdir -p /workspace/datasets /workspace/runs /workspace/logs /workspace/logs/plots

