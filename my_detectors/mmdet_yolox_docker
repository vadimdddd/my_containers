def render_dict(d, indent=0):
    """Рекурсивный рендер dict в python-литерал с отступами."""
    pad = "    " * indent
    lines = ["{"]
    for k, v in d.items():
        if isinstance(v, dict):
            rendered = render_dict(v, indent + 1)
            lines.append(f"{pad}    '{k}': {rendered},")
        elif isinstance(v, (list, tuple)):
            lines.append(f"{pad}    '{k}': {list(v)},")
        else:
            lines.append(f"{pad}    '{k}': {v!r},")
    lines.append(f"{pad}}}")
    return "\n".join(lines)


def generate(args):
    backbone = BACKBONE_TEMPLATES[args.backbone].copy()
    neck = NECK_TEMPLATES[args.neck].copy()
    head = HEAD_TEMPLATES[args.head].copy()

    # Согласование размерностей (упрощённо для дефолтных случаев)
    if args.backbone == "CSPDarknet":
        neck["in_channels"] = [128, 256, 512]
        neck["out_channels"] = 128
        head["in_channels"] = 128
    elif args.backbone == "ResNet":
        neck["in_channels"] = [512, 1024, 2048]
        neck["out_channels"] = 256
        head["in_channels"] = 256
    elif args.backbone == "SwinTransformer":
        neck["in_channels"] = [192, 384, 768]
        neck["out_channels"] = 256
        head["in_channels"] = 256
    elif args.backbone == "HRNet":
        neck["in_channels"] = [48, 96, 192, 384]
        neck["out_channels"] = 256
        head["in_channels"] = 256

    head["num_classes"] = args.num_classes

    detector_type = DETECTOR_BY_HEAD[args.head]

    # Сохраняем в файл
    out_path = Path("/workspace/configs_generated/generated_config.py")
    out_path.parent.mkdir(parents=True, exist_ok=True)

    config_body = f"""# Автоматически сгенерированный конфиг MMDetection
# BACKBONE = {args.backbone}
# NECK     = {args.neck}
# HEAD     = {args.head}
# NUM_CLASSES = {args.num_classes}
# DATASET_TYPE = {args.dataset_type}

dataset_type = '{args.dataset_type}'
data_root = '{args.data_root}'
classes = {list(args.classes)}

img_norm_cfg = dict(mean=[0, 0, 0], std=[1, 1, 1], to_rgb=True)
img_scale = ({args.img_size}, {args.img_size})

model = dict(
    type='{detector_type}',
    backbone={render_dict(backbone, 1)},
    neck={render_dict(neck, 1)},
    bbox_head={render_dict(head, 1)},
    train_cfg=dict(assigner=dict(type='SimOTAAssigner', center_radius=2.5)),
    test_cfg=dict(score_thr=0.01, nms=dict(type='nms', iou_threshold=0.65)),
)

# Пайплайны, датасеты, расписание — стандартные для YOLOX/MMDetection
train_pipeline = [
    dict(type='Mosaic', img_scale=img_scale, pad_val=114.0),
    dict(type='RandomAffine', scaling_ratio_range=(0.5, 1.5),
         border=(-img_scale[0] // 2, -img_scale[1] // 2)),
    dict(type='MixUp', ratio_range=(0.8, 1.6), pad_val=114.0),
    dict(type='YOLOXHSVRandomAug'),
    dict(type='RandomFlip', flip_ratio=0.5),
    dict(type='Resize', img_scale=img_scale, keep_ratio=True),
    dict(type='Pad', size_divisor=32, pad_val=dict(img=(114.0, 114.0, 114.0))),
    dict(type='Normalize', **img_norm_cfg),
    dict(type='FilterAnnotations', min_gt_bbox_wh=(1, 1), keep_empty=False),
    dict(type='DefaultFormatBundle'),
    dict(type='Collect', keys=['img', 'gt_bboxes', 'gt_labels']),
]

test_pipeline = [
    dict(type='LoadImageFromFile'),
    dict(type='MultiScaleFlipAug', img_scale=img_scale,
         flip=False, transforms=[
            dict(type='Resize', keep_ratio=True),
            dict(type='RandomFlip'),
            dict(type='Pad', size_divisor=32,
                 pad_val=dict(img=(114.0, 114.0, 114.0))),
            dict(type='Normalize', **img_norm_cfg),
            dict(type='ImageToTensor', keys=['img']),
            dict(type='Collect', keys=['img']),
         ]),
]

data = dict(
    samples_per_gpu={args.batch},
    workers_per_gpu={args.workers},
    train=dict(type=dataset_type, classes=classes,
               ann_file=f'{{data_root}}/annotations/trainval.json',
               img_prefix=f'{{data_root}}/train/',
               pipeline=train_pipeline),
    val=dict(type=dataset_type, classes=classes,
             ann_file=f'{{data_root}}/annotations/test.json',
             img_prefix=f'{{data_root}}/test/',
             pipeline=test_pipeline),
    test=dict(type=dataset_type, classes=classes,
              ann_file=f'{{data_root}}/annotations/test.json',
              img_prefix=f'{{data_root}}/test/',
              pipeline=test_pipeline),
)

optimizer = dict(type='SGD', lr=0.01, momentum=0.9, weight_decay=0.0005)
lr_config = dict(policy='step', warmup='linear',
                 warmup_iters=1000, warmup_ratio=0.001,
                 step=[{args.epochs - 15}, {args.epochs - 5}])
runner = dict(type='EpochBasedRunner', max_epochs={args.epochs})
evaluation = dict(interval=10, metric='bbox')
checkpoint_config = dict(interval=10)
log_config = dict(interval=50, hooks=[dict(type='TextLoggerHook')])
total_epochs = {args.epochs}
"""

    out_path.write_text(config_body)
    print(f"[OK] Generated config: {out_path}")
    print(f"     BACKBONE = {args.backbone}")
    print(f"     NECK     = {args.neck}")
    print(f"     HEAD     = {args.head}")
    print(f"     DETECTOR = {detector_type}")
    return str(out_path)


def main():
    p = argparse.ArgumentParser(description="MMDetection config generator")
    p.add_argument("--config", default=os.environ.get("CONFIG", ""),
                   help="Готовый конфиг. Если задан — генерация пропускается.")
    p.add_argument("--backbone", default=os.environ.get("BACKBONE", "CSPDarknet"),
                   choices=list(BACKBONE_TEMPLATES.keys()))
    p.add_argument("--neck", default=os.environ.get("NECK", "YOLOXPAFPN"),
                   choices=list(NECK_TEMPLATES.keys()))
    p.add_argument("--head", default=os.environ.get("HEAD", "YOLOXHead"),
                   choices=list(HEAD_TEMPLATES.keys()))
    p.add_argument("--num-classes", type=int,
                   default=int(os.environ.get("NUM_CLASSES", "3")))
    p.add_argument("--classes", nargs="+",
                   default=os.environ.get("CLASSES", "class1 class2 class3").split())
    p.add_argument("--epochs", type=int,
                   default=int(os.environ.get("EPOCHS", "300")))
    p.add_argument("--batch", type=int,
                   default=int(os.environ.get("BATCH", "8")))
    p.add_argument("--workers", type=int,
                   default=int(os.environ.get("WORKERS", "4")))
    p.add_argument("--img-size", type=int,
                   default=int(os.environ.get("IMG_SIZE", "640")))
    p.add_argument("--dataset-type",
                   default=os.environ.get("DATASET_TYPE", "CocoDataset"))
    p.add_argument("--data-root",
                   default=os.environ.get("DATA_ROOT",
                                         "/workspace/mmdetection/data/VOC2007"))
    args = p.parse_args()

    # Обратная совместимость: если CONFIG задан — используем его
    if args.config:
        print(f"[INFO] CONFIG is set, using existing config: {args.config}")
        print(args.config)
        return

    # Иначе — генерируем
    generate(args)


if __name__ == "__main__":
    main()
