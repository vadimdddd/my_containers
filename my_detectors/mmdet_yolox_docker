# =============================================================================
# mmdet_yolox_docker.dockerfile
# MMDetection v2.27.0 — модульный пайплайн: backbone + neck + head собираются
# из env-переменных. Дефолт — YOLOX-S (CSPDarknet + YOLOXPAFPN + YOLOXHead).
#
#   convert > train > test .pth > export .onnx > test .onnx > plots
#
# ЗАЧЕМ ЭТОТ ОБРАЗ:
#   Один `docker run` выполняет все 6 стадий. Если CONFIG не задан — собирает
#   конфиг из BACKBONE + NECK + HEAD. Если задан — использует готовый конфиг.
#
# ЛИЦЕНЗИЯ:
#   Apache 2.0 на код и веса. Можно в закрытых коммерческих продуктах.
#
# СОВМЕСТИМОСТЬ ВЕРСИЙ:
#   MMDetection 2.27.0 + mmcv-full 1.7.0 + torch 1.10.0 + cu113.
#   mmdeploy 0.12.0 — для экспорта YOLOX в ONNX (обход bbox_coder).
# =============================================================================

FROM pytorch/pytorch:1.10.0-cuda11.3-cudnn8-devel

# -----------------------------------------------------------------------------
# СИСТЕМНЫЕ ЗАВИСИМОСТИ
#   git, wget — клонирование репо и скачивание весов
#   libgl1, libglib2.0-0, libsm6, libxext6, libxrender-dev — OpenCV
#   gcc, g++, ninja-build — сборка mmcv-full/mmdeploy из исходников
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget libgl1 libglib2.0-0 libsm6 libxext6 libxrender-dev \
    gcc g++ ninja-build \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# -----------------------------------------------------------------------------
# ФИКСАЦИЯ TORCHVISION ПОД CUDA 11.3
#   MMDetection использует torchvision.ops.nms и box_iou.
# -----------------------------------------------------------------------------
RUN pip install --no-cache-dir \
    torchvision==0.11.0 torchaudio==0.10.0 \
    --index-url https://download.pytorch.org/whl/cu113

# -----------------------------------------------------------------------------
# MMCV-FULL 1.7.0 (из wheel-репозитория OpenMMLab)
#
# ЗАЧЕМ: ядро OpenMMLab с CUDA-операторами (NMS, RoIAlign, deform_conv).
# ОТКУДА: официальный репозиторий под torch1.10.0 + cu113 .
# -----------------------------------------------------------------------------
RUN pip install --no-cache-dir \
    mmcv-full==1.7.0 \
    -f https://download.openmmlab.com/mmcv/dist/cu113/torch1.10.0/index.html

# -----------------------------------------------------------------------------
# MMDETECTION v2.27.0
#
# ЗАЧЕМ: официальный репозиторий. Содержит tools/train.py, tools/test.py,
#        configs/yolox/, tools/dataset_converters/pascal_voc.py.
# -----------------------------------------------------------------------------
RUN git clone -b 'v2.27.0' https://github.com/open-mmlab/mmdetection.git . \
    && pip install --no-cache-dir -v -e .

# -----------------------------------------------------------------------------
# MMDEPLOY v0.12.0 (для экспорта YOLOX в ONNX)
#
# ЗАЧЕМ: прямой экспорт через pytorch2onnx.py падает с bbox_coder.
#        mmdeploy имеет исправленный пайплайн для YOLOX.
# -----------------------------------------------------------------------------
RUN pip install --no-cache-dir pybind11 onnxruntime onnx onnxsim \
    && git clone -b 'v0.12.0' https://github.com/open-mmlab/mmdeploy.git /workspace/mmdeploy \
    && cd /workspace/mmdeploy && pip install --no-cache-dir -v -e .

# -----------------------------------------------------------------------------
# ДОПОЛНИТЕЛЬНЫЕ ЗАВИСИМОСТИ ДЛЯ КОНВЕРТАЦИИ, ТЕСТА И ГРАФИКОВ
#   scikit-learn — train_test_split в скрипте конвертации
#   lxml — для парсинга XML
#   pycocotools — COCOeval
#   supervision — confusion matrix
#   matplotlib, seaborn, pandas — графики
# -----------------------------------------------------------------------------
RUN pip install --no-cache-dir \
    scikit-learn lxml \
    pycocotools supervision \
    opencv-python-headless \
    matplotlib seaborn pandas scipy

# -----------------------------------------------------------------------------
# ДИРЕКТОРИИ ДЛЯ МОНТИРОВАНИЯ
#   /workspace/datasets — исходные LabelMe JSON+JPG (монтируется)
#   /workspace/mmdetection/data — VOC+COCO, генерируемые скриптом
#   /workspace/work_dirs — чекпоинты
#   /workspace/runs — ONNX + промежуточные артефакты
#   /workspace/logs — логи и графики
# -----------------------------------------------------------------------------
RUN mkdir -p /workspace/datasets /workspace/runs /workspace/logs /workspace/logs/plots \
    /workspace/mmdetection/data /workspace/work_dirs /workspace/configs_generated

# =============================================================================
# ГЕНЕРАТОР КОНФИГОВ (argparse)
#
# ЧТО ДЕЛАЕТ:
#   Собирает .py-конфиг MMDetection из выбранных BACKBONE + NECK + HEAD.
#   Если CONFIG задан через env — ничего не генерирует, использует готовый.
#
# ПОДДЕРЖИВАЕМЫЕ КОМБИНАЦИИ:
#   BACKBONE: CSPDarknet | ResNet | SwinTransformer | HRNet
#   NECK:     YOLOXPAFPN | FPN | PAFPN | NASFPN
#   HEAD:     YOLOXHead | FCOSHead | ATSSHead | RetinaHead
#
# ДЕФОЛТ: CSPDarknet + YOLOXPAFPN + YOLOXHead = YOLOX-S
# =============================================================================
