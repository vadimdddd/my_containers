def get_filename_without_extension(filename):
    return os.path.splitext(os.path.basename(filename))[0]


def make_empty_folder(out_path):
    if not os.path.exists(out_path):
        os.makedirs(out_path)
    for f in glob.glob(os.path.join(out_path, '*.*')):
        os.remove(f)


def correct_box_coords(x1y1x2y2, h, w):
    x1, y1, x2, y2 = x1y1x2y2
    c = False
    if x1 < 0: x1 = 0; c = True
    if x1 > w: x1 = w; c = True
    if x2 < 0: x2 = 0; c = True
    if x2 > w: x2 = w; c = True
    if y1 < 0: y1 = 0; c = True
    if y1 > h: y1 = h; c = True
    if y2 < 0: y2 = 0; c = True
    if y2 > h: y2 = h; c = True
    if x1 > x2: x2, x1 = x1, x2; c = True
    if y1 > y2: y2, y1 = y1, y2; c = True
    return [x1, y1, x2, y2]


def pretty_print_xml(elem):
    rough_string = ET.tostring(elem, 'utf-8')
    reparsed = minidom.parseString(rough_string)
    reparsed = reparsed.toprettyxml(indent='  ')
    reparsed = reparsed.replace('<?xml version="1.0" ?>', '<?xml version="1.0" encoding="utf-8"?>')
    return reparsed


def find_subfolders_with_json(root):
    trainval, test = [], []
    for dirpath, dirnames, filenames in os.walk(root):
        if not any(f.endswith('.json') for f in filenames):
            continue
        dirname = os.path.basename(dirpath).lower()
        if 'test' in dirname:
            test.append(dirpath)
        elif 'trainval' in dirname or 'train' in dirname:
            trainval.append(dirpath)
        else:
            trainval.append(dirpath)
    return sorted(trainval), sorted(test)


def main():
    print("=" * 60)
    print("LabelMe JSON > Pascal VOC XML > COCO")
    print("=" * 60)
    print(f"DATASETS_DIR: {DATASETS_DIR}")
    print(f"WORK_DIR: {WORK_DIR}")

    make_empty_folder(PATH_TO)
    make_empty_folder(PATH_TO_ANNO)
    make_empty_folder(PATH_TO_ISET)
    make_empty_folder(PATH_TO_IMGS)

    paths_trainval, paths_test = find_subfolders_with_json(DATASETS_DIR)
    print(f"Trainval folders: {len(paths_trainval)}")
    print(f"Test folders: {len(paths_test)}")

    if not paths_trainval and not paths_test:
        print("ERROR: No LabelMe JSON found in datasets/")
        sys.exit(1)

    obj_candidates = [os.path.join(DATASETS_DIR, OBJ_NAMES_FILE)]
    if paths_trainval:
        obj_candidates.append(os.path.join(paths_trainval[0], OBJ_NAMES_FILE))
    if paths_test:
        obj_candidates.append(os.path.join(paths_test[0], OBJ_NAMES_FILE))
    obj_names_path = next((p for p in obj_candidates if os.path.exists(p)), None)
    if obj_names_path is None:
        print(f"ERROR: {OBJ_NAMES_FILE} not found")
