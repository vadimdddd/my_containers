"""LabelMe JSON > Pascal VOC XML для MMDetection."""
import os, sys, glob, shutil, json
import cv2
import numpy as np
from sklearn.model_selection import train_test_split
import xml.etree.ElementTree as ET
from xml.dom import minidom


