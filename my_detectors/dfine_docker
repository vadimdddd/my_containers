# СТАДИЯ 4/5: ТЕСТ .onnx
# =============================================================================
COPY <<'PYTHON' /workspace/04_test_onnx.py
import argparse, os, time, pickle
import cv2
import numpy as np
import onnxruntime as ort
from pathlib import Path
from pycocotools.coco import COCO
from pycocotools.cocoeval import COCOeval

def preprocess(img, imgsz=640):
    img = cv2.resize(img, (imgsz, imgsz))
    img = img[:, :, ::-1].transpose(2, 0, 1).astype(np.float32) / 255.0
    return np.expand_dims(img, axis=0)

def postprocess(outputs, conf_thres=0.5):
    labels, scores, boxes = outputs
    return [{"bbox": boxes[i].tolist(), "class_id": int(labels[i]), "score": float(scores[i])}
            for i in range(len(scores)) if scores[i] > conf_thres]

def main():
    p = argparse.ArgumentParser()
    p.add_argument("--onnx", default=os.environ.get("ONNX_PATH"))
    p.add_argument("--dataset", default=os.environ.get("TEST_ANNOTATIONS"))
    p.add_argument("--images", default=os.environ.get("TEST_IMAGES"))
    p.add_argument("--log", default="/workspace/logs/04_test_onnx.log")
    args = p.parse_args()

    with open(args.log, "a") as f:
        f.write(f"=== D-FINE Test (ONNX) ===\n")
        f.write(f"Timestamp: {time.strftime('%Y-%m-%d %H:%M:%S')}\n")
        f.write(f"ONNX: {args.onnx}\n---\n")

    session = ort.InferenceSession(args.onnx, providers=["CUDAExecutionProvider", "CPUExecutionProvider"])
    input_names = [i.name for i in session.get_inputs()]

    coco = COCO(args.dataset)
    results, latencies = [], []
    for img_id in coco.getImgIds():
        info = coco.loadImgs(img_id)[0]
        img = cv2.imread(str(Path(args.images) / info["file_name"]))
        h, w = img.shape[:2]
        inp = preprocess(img)
        size = np.array([[w, h]], dtype=np.int64)

        t0 = time.perf_counter()
        outputs = session.run(None, {input_names[0]: inp, input_names[1]: size})
        t1 = time.perf_counter()
        latencies.append((t1 - t0) * 1000)

        for det in postprocess(outputs):
            x1, y1, x2, y2 = det["bbox"]
            results.append({
                "image_id": img_id,
                "category_id": det["class_id"] + 1,
                "bbox": [x1, y1, x2 - x1, y2 - y1],
                "score": det["score"],
            })

    coco_dt = coco.loadRes(results)
    ev = COCOeval(coco, coco_dt, "bbox")
    ev.evaluate(); ev.accumulate(); ev.summarize()

    with open(args.log, "a") as f:
        f.write(f"mAP@0.5: {ev.stats[1]:.4f}\n")
        f.write(f"mAP@0.5:0.95: {ev.stats[0]:.4f}\n")
        f.write(f"Avg latency: {sum(latencies)/len(latencies):.2f} ms\n")
        f.write("ONNX test complete.\n")

    class_names = [c["name"] for c in coco.loadCats(coco.getCatIds())]
    with open("/workspace/logs/plots/coco_eval.pkl", "wb") as f:
        pickle.dump({"coco_eval": ev, "class_names": class_names, "results": results}, f)

if __name__ == "__main__":
    main()
PYTHON

