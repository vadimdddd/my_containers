# =============================================================================
# dfine_docker.dockerfile
# D-FINE (Apache 2.0) — полностью автоматический пайплайн:
#   train > test .pth > export .onnx > test .onnx > plots
#
# ЗАЧЕМ ЭТОТ ОБРАЗ:
#   Один `docker run` выполняет все 5 стадий и даёт готовую .onnx + 6 логов
#   + 4 графика.
#
# ЛИЦЕНЗИЯ:
#   Apache 2.0 на код и веса. Можно в закрытых коммерческих продуктах.
#
# СОВМЕСТИМОСТЬ ВЕРСИЙ:
#   PyTorch 2.6.0 + CUDA 12.6. Поддерживает multi-GPU через torchrun.
# =============================================================================

# -----------------------------------------------------------------------------
# БАЗОВЫЙ ОБРАЗ: PyTorch 2.6.0 + CUDA 12.6 + cuDNN 9 (devel)
# -----------------------------------------------------------------------------
FROM pytorch/pytorch:2.6.0-cuda12.6-cudnn9-devel

# -----------------------------------------------------------------------------
# СИСТЕМНЫЕ ЗАВИСИМОСТИ
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget libgl1 libglib2.0-0 libsm6 libxext6 libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# -----------------------------------------------------------------------------
# ФИКСАЦИЯ TORCH/TORCHVISION ПОД CUDA 12.6
# -----------------------------------------------------------------------------
RUN pip install --no-cache-dir \
    torch==2.6.0 torchvision==0.21.0 torchaudio==2.6.0 \
    --index-url https://download.pytorch.org/whl/cu126

# -----------------------------------------------------------------------------
# КЛОНИРОВАНИЕ D-FINE + ЗАВИСИМОСТИ
#   Peterande/D-FINE — официальный репозиторий. Содержит train.py, configs/,
#   tools/deployment/export_onnx.py.
# -----------------------------------------------------------------------------
RUN git clone https://github.com/Peterande/D-FINE.git . \
    && pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir onnx onnxruntime onnxsim pycocotools \
    && pip install --no-cache-dir supervision matplotlib seaborn pandas scipy

# -----------------------------------------------------------------------------
# ПРЕДОБУЧЕННЫЕ ВЕСА Objects365
#   Лучшая стартовая точка для кастомных датасетов (рекомендация авторов).
# -----------------------------------------------------------------------------
RUN mkdir -p /workspace/weights && \
    wget -q https://github.com/Peterande/storage/releases/download/dfinev1.0/dfine_m_obj365.pth \
    -O /workspace/weights/dfine_m_obj365.pth || true

RUN mkdir -p /workspace/datasets /workspace/runs /workspace/logs /workspace/logs/plots /workspace/configs/dfine/custom

# =============================================================================
# СТАДИЯ 1/5: ТРЕНИРОВКА
# =============================================================================
COPY <<'SHELL' /workspace/01_train.sh
#!/bin/bash
set -e
LOG_FILE=${LOG_FILE:-/workspace/logs/01_train.log}
{
echo "=== D-FINE Training ==="
echo "Timestamp: $(date)"
echo "PyTorch: $(python -c 'import torch; print(torch.__version__, torch.version.cuda)')"
echo "Config: ${CONFIG}"
echo "GPUs: ${GPUS:-1}"
echo "---"

if [ "${GPUS:-1}" -gt 1 ]; then
    CUDA_VISIBLE_DEVICES=0,1,2,3 torchrun --master_port=7777 \
        --nproc_per_node=${GPUS} train.py -c ${CONFIG} --use-amp --seed=0
else
    python train.py -c ${CONFIG} --use-amp --seed=0
fi

echo "Training complete."
} 2>&1 | tee $LOG_FILE
SHELL
RUN chmod +x /workspace/01_train.sh

# =============================================================================
# СТАДИЯ 2/5: ТЕСТ .pth
# =============================================================================
COPY <<'SHELL' /workspace/02_test_pth.sh
#!/bin/bash
set -e
LOG_FILE=${LOG_FILE:-/workspace/logs/02_test_pth.log}
{
echo "=== D-FINE Test (PTH) ==="
echo "Timestamp: $(date)"
echo "Weights: ${TRAINED_WEIGHTS}"
echo "---"

torchrun --master_port=7777 --nproc_per_node=${GPUS:-1} train.py \
    -c ${CONFIG} --test-only -r ${TRAINED_WEIGHTS}

echo "PTH test complete."
} 2>&1 | tee $LOG_FILE
SHELL
RUN chmod +x /workspace/02_test_pth.sh

# =============================================================================
# СТАДИЯ 3/5: ЭКСПОРТ В ONNX
# =============================================================================
COPY <<'SHELL' /workspace/03_export_onnx.sh
#!/bin/bash
set -e
LOG_FILE=${LOG_FILE:-/workspace/logs/03_export.log}
{
echo "=== D-FINE ONNX Export ==="
echo "Timestamp: $(date)"
echo "Weights: ${TRAINED_WEIGHTS}"
echo "---"

sed -i 's/data = torch.rand(.*/data = torch.rand(1, 3, 640, 640)/' tools/deployment/export_onnx.py

python3 tools/deployment/export_onnx.py \
    -c ${CONFIG} -r ${TRAINED_WEIGHTS} --check --simplify

echo "ONNX export complete."
} 2>&1 | tee $LOG_FILE
SHELL
RUN chmod +x /workspace/03_export_onnx.sh

