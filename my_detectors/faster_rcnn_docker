        f.write(f"Avg latency: {sum(latencies)/len(latencies):.2f} ms\n")

    class_names = [c["name"] for c in coco.loadCats(coco.getCatIds())]
    with open("/workspace/logs/plots/coco_eval.pkl", "wb") as f:
        pickle.dump({"coco_eval": ev, "class_names": class_names, "results": results}, f)


