COPY <<'PYTHON' /workspace/00_convert.py
"""LabelMe JSON > Pascal VOC XML."""
import os, sys, glob, shutil, json
import cv2
import numpy as np
from sklearn.model_selection import train_test_split
import xml.etree.ElementTree as ET
from xml.dom import minidom

DATASETS_DIR = os.environ.get("DATASETS_DIR", "/workspace/datasets")
WORK_DIR = os.environ.get("MMDET_DATA_DIR", "/workspace/mmdetection/data")
DATA_MAIN_FOLDER = os.environ.get("DATA_MAIN_FOLDER", "nlmk_dp_data")
OBJ_NAMES_FILE = os.environ.get("OBJ_NAMES_FILE", "obj.names")
SPLIT_SIZE = float(os.environ.get("SPLIT_SIZE", "0.05"))
RANDOM_STATE = int(os.environ.get("RANDOM_STATE", "42"))

PATH_TO = os.path.join(WORK_DIR, DATA_MAIN_FOLDER)
PATH_TO_ANNO = os.path.join(PATH_TO, 'Annotations')
PATH_TO_ISET = os.path.join(PATH_TO, 'ImageSets', 'Main')
PATH_TO_IMGS = os.path.join(PATH_TO, 'JPEGImages')


def get_base(f):
    return os.path.splitext(os.path.basename(f))[0]


def make_empty(p):
    if not os.path.exists(p):
        os.makedirs(p)
    for f in glob.glob(os.path.join(p, '*.*')):
        os.remove(f)


def correct_box(b, h, w):
    x1, y1, x2, y2 = b
    x1, y1 = max(0, min(x1, w)), max(0, min(y1, h))
    x2, y2 = max(0, min(x2, w)), max(0, min(y2, h))
    if x1 > x2: x1, x2 = x2, x1
    if y1 > y2: y1, y2 = y2, y1
    return [x1, y1, x2, y2]


def pretty_xml(elem):
    s = ET.tostring(elem, 'utf-8')
    return minidom.parseString(s).toprettyxml(indent='  ').replace(
        '<?xml version="1.0" ?>', '<?xml version="1.0" encoding="utf-8"?>')


def find_subfolders(root):
    trainval, test = [], []
    for dp, dn, fn in os.walk(root):
        if not any(f.endswith('.json') for f in fn):
            continue
        d = os.path.basename(dp).lower()
        if 'test' in d:
            test.append(dp)
        elif 'trainval' in d or 'train' in d:
            trainval.append(dp)
        else:
            trainval.append(dp)
    return sorted(trainval), sorted(test)


def main():
    print("=" * 60)
    print("LabelMe JSON > Pascal VOC XML")
    make_empty(PATH_TO)
    make_empty(PATH_TO_ANNO)
    make_empty(PATH_TO_ISET)
    make_empty(PATH_TO_IMGS)

    paths_trainval, paths_test = find_subfolders(DATASETS_DIR)
    print(f"Trainval folders: {len(paths_trainval)}")
    print(f"Test folders: {len(paths_test)}")

    if not paths_trainval and not paths_test:
        print("ERROR: No LabelMe JSON found")
        sys.exit(1)

    obj_candidates = [os.path.join(DATASETS_DIR, OBJ_NAMES_FILE)]
    if paths_trainval:
        obj_candidates.append(os.path.join(paths_trainval[0], OBJ_NAMES_FILE))
    obj_path = next((p for p in obj_candidates if os.path.exists(p)), None)
    if obj_path is None:
        print(f"ERROR: {OBJ_NAMES_FILE} not found")
        sys.exit(1)

    with open(obj_path) as f:
        LABEL_LIST = [l.strip() for l in f if l.strip()]
    print(f"Classes: {LABEL_LIST}")
    shutil.copy2(obj_path, os.path.join(PATH_TO, OBJ_NAMES_FILE))

    trainval_json = []
    for p in paths_trainval:
        trainval_json.extend(sorted(glob.glob(os.path.join(p, '*.json'))))
    test_json = []
    for p in paths_test:
        test_json.extend(sorted(glob.glob(os.path.join(p, '*.json'))))

    print(f"JSON trainval: {len(trainval_json)}")
    print(f"JSON test: {len(test_json)}")

    for i, fname in enumerate(trainval_json + test_json):
        if i % 500 == 0:
            print(f"  [{i}/{len(trainval_json) + len(test_json)}]")
        base = get_base(fname)
        src_dir = os.path.dirname(fname)
        jpeg_in = os.path.join(src_dir, base + '.jpg')
        jpeg_out = os.path.join(PATH_TO_IMGS, base + '.jpg')
        if os.path.exists(jpeg_in):
            shutil.copy2(jpeg_in, jpeg_out)

        xml_out = os.path.join(PATH_TO_ANNO, base + '.xml')
        img = cv2.imread(jpeg_out)
        if img is None:
            continue
        h, w = img.shape[:2]

        with open(fname, encoding='utf-8') as f:
            data = json.load(f)

        root = ET.Element('annotation')
        ET.SubElement(root, 'folder').text = DATA_MAIN_FOLDER
        ET.SubElement(root, 'filename').text = base + '.jpg'
        src = ET.SubElement(root, 'source')
        ET.SubElement(src, 'database').text = 'NLMK CHVK VOC Database'
        sz = ET.SubElement(root, 'size')
        ET.SubElement(sz, 'height').text = str(h)
        ET.SubElement(sz, 'width').text = str(w)
        ET.SubElement(sz, 'depth').text = str(img.shape[2] if len(img.shape) == 3 else 1)
        ET.SubElement(root, 'segmented').text = '0'

        for shape in data.get('shapes', []):
            label = shape['label']
            if label not in LABEL_LIST:
                continue
            pts = np.array(shape['points']).astype(int)
            x_min, y_min = np.min(pts, axis=0)
            x_max, y_max = np.max(pts, axis=0)
            x_min, y_min, x_max, y_max = correct_box([x_min, y_min, x_max, y_max], h, w)
            obj = ET.SubElement(root, 'object')
            ET.SubElement(obj, 'difficult').text = '0'
            ET.SubElement(obj, 'truncated').text = '0'
            ET.SubElement(obj, 'name').text = label
            bnd = ET.SubElement(obj, 'bndbox')
            ET.SubElement(bnd, 'xmin').text = str(x_min)
            ET.SubElement(bnd, 'ymin').text = str(y_min)
            ET.SubElement(bnd, 'xmax').text = str(x_max)
            ET.SubElement(bnd, 'ymax').text = str(y_max)

        with open(xml_out, 'wb') as f:
            f.write(pretty_xml(root).encode('utf-8'))

    trainval_xml = [get_base(f) for f in trainval_json]
    test_xml = [get_base(f) for f in test_json]

    if len(trainval_xml) > 1:
        train_ids, val_ids = train_test_split(trainval_xml, test_size=SPLIT_SIZE,
                                               random_state=RANDOM_STATE)
    else:
        train_ids, val_ids = trainval_xml, []

    print(f"Train: {len(train_ids)}, Val: {len(val_ids)}, Test: {len(test_xml)}")

    for name, ids in [('trainval.txt', train_ids + val_ids), ('train.txt', train_ids),
                      ('val.txt', val_ids), ('test.txt', test_xml)]:
        with open(os.path.join(PATH_TO_ISET, name), 'w') as f:
            for x in ids:
                f.write(x + '\n')


if __name__ == '__main__':
    main()
PYTHON

