        elif isinstance(v, (list, tuple)):
            lines.append(f"{pad}    '{k}': {list(v)},")
        else:
            lines.append(f"{pad}    '{k}': {v!r},")
    lines.append(f"{pad}}}")
    return "\n".join(lines)


