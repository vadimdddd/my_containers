COPY <<'PYTHON' /workspace/04_test_onnx.py
import argparse, os, time, pickle
import cv2
import numpy as np
import onnxruntime as ort
from pathlib import Path
from pycocotools.coco import COCO
from pycocotools.cocoeval import COCOeval


def preprocess(img, imgsz=640):
    img = cv2.resize(img, (imgsz, imgsz))
    img = img[:, :, ::-1].astype(np.float32)
    mean = np.array([123.675, 116.28, 103.53], dtype=np.float32)
    std = np.array([58.395, 57.12, 57.375], dtype=np.float32)
    img = (img - mean) / std
    img = img.transpose(2, 0, 1)
    return np.expand_dims(img, axis=0)


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--onnx", default=os.environ.get("ONNX_PATH"))
    p.add_argument("--dataset", default=os.environ.get("TEST_ANNOTATIONS"))
    p.add_argument("--images", default=os.environ.get("TEST_IMAGES"))
    p.add_argument("--log", default="/workspace/logs/04_test_onnx.log")
    args = p.parse_args()

    with open(args.log, "a") as f:
        f.write(f"=== Faster R-CNN Test (ONNX) ===\nTimestamp: {time.strftime('%Y-%m-%d %H:%M:%S')}\n")
        f.write(f"ONNX: {args.onnx}\n---\n")

    session = ort.InferenceSession(args.onnx, providers=["CUDAExecutionProvider", "CPUExecutionProvider"])
    input_names = [i.name for i in session.get_inputs()]

    coco = COCO(args.dataset)
    results, latencies = [], []
    for img_id in coco.getImgIds():
        info = coco.loadImgs(img_id)[0]
        img = cv2.imread(str(Path(args.images) / info["file_name"]))
        if img is None:
            continue
        inp = preprocess(img)
        t0 = time.perf_counter()
        outputs = session.run(None, {input_names[0]: inp})
        t1 = time.perf_counter()
        latencies.append((t1 - t0) * 1000)

        # ONNX-‚˚ıÓ‰ Faster R-CNN ÓÚ mmdeploy: [dets, labels]
        dets = outputs[0]
        labels = outputs[1]
        for det, lbl in zip(dets[0], labels[0]):
            x1, y1, x2, y2, score = det[:5]
            if score < 0.05:
                continue
            results.append({
                "image_id": img_id,
                "category_id": int(lbl) + 1,
                "bbox": [float(x1), float(y1), float(x2 - x1), float(y2 - y1)],
                "score": float(score),
            })

    if not results:
        with open(args.log, "a") as f:
            f.write("WARN: no detections\n")
        return

    coco_dt = coco.loadRes(results)
    ev = COCOeval(coco, coco_dt, "bbox")
    ev.evaluate(); ev.accumulate(); ev.summarize()

    with open(args.log, "a") as f:
        f.write(f"mAP@0.5: {ev.stats[1]:.4f}\n")
