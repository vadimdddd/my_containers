FROM pytorch/pytorch:2.6.0-cuda12.6-cudnn9-devel

RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget libgl1 libglib2.0-0 libsm6 libxext6 libxrender-dev \
    gcc g++ ninja-build libsparsehash-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# MMEngine, MMCV 2.x, MMDetection 3.x ˜ÂÂÁ mim
RUN pip install --no-cache-dir openmim \
    && mim install mmengine \
    && mim install 'mmcv>=2.0.0rc4' \
    && mim install 'mmdet>=3.0.0'

# spconv 2.x ‰Îˇ sparse convolutions
RUN pip install --no-cache-dir cumm-cu126 spconv-cu126

# MMDetection3D v1.0.0rc5
RUN git clone -b 'v1.0.0rc5' https://github.com/open-mmlab/mmdetection3d.git . \
    && pip install --no-cache-dir -v -e .

RUN pip install --no-cache-dir \
    open3d \
    scipy scikit-learn \
    opencv-python-headless \
    matplotlib seaborn pandas

RUN mkdir -p /workspace/datasets /workspace/runs /workspace/logs /workspace/logs/plots \
    /workspace/mmdetection3d/data /workspace/work_dirs

