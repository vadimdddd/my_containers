COPY <<'PYTHON' /workspace/00_prepare_data.py
"""
œÓ‰„ÓÚÓ‚Í‡ KITTI-ÙÓÏ‡Ú‡ ‰Îˇ MMDetection3D.

Œ∆»ƒ¿≈Ã¿ﬂ —“–” “”–¿:
  datasets/kitti/
    +-- ImageSets/
    +-- training/
    ¶   +-- calib/*.txt
    ¶   +-- image_2/*.png
    ¶   +-- label_2/*.txt
    ¶   L-- velodyne/*.bin
    L-- testing/
        +-- calib/
        +-- image_2/
        L-- velodyne/
"""
import os
import subprocess

DATASETS_DIR = os.environ.get("DATASETS_DIR", "/workspace/datasets")
MMDET3D_DATA = os.environ.get("MMDET3D_DATA", "/workspace/mmdetection3d/data")

def main():
    src = os.path.join(DATASETS_DIR, "kitti")
    dst = os.path.join(MMDET3D_DATA, "kitti")

    if not os.path.exists(dst):
        os.makedirs(MMDET3D_DATA, exist_ok=True)
        os.symlink(src, dst)

    cmd = [
        "python", "/workspace/mmdetection3d/tools/create_data.py", "kitti",
        "--root-path", dst,
        "--out-dir", dst,
        "--extra-tag", "kitti",
    ]
    subprocess.run(cmd, check=True)
    print(f"[OK] KITTI data prepared at {dst}")

if __name__ == "__main__":
    main()
PYTHON

