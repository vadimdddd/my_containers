COPY <<'SHELL' /workspace/01_train.sh
#!/bin/bash
set -e
LOG_FILE=${LOG_FILE:-/workspace/logs/01_train.log}
{
echo "=== MMDetection3D Training ==="
echo "Timestamp: $(date)"
echo "Config: ${CONFIG:-configs/pointpillars/pointpillars_hv_secfpn_8xb6-160e_kitti-3d-3class.py}"
echo "---"

cd /workspace/mmdetection3d
if [ "${GPUS:-1}" -gt 1 ]; then
    bash tools/dist_train.sh ${CONFIG} ${GPUS} --work-dir /workspace/work_dirs/${RUN_NAME:-mmdet3d}
else
    python tools/train.py ${CONFIG} --work-dir /workspace/work_dirs/${RUN_NAME:-mmdet3d}
fi
} 2>&1 | tee $LOG_FILE
SHELL
RUN chmod +x /workspace/01_train.sh

