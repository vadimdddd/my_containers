# =============================================================================
# detectron2_docker.dockerfile
# Detectron2 (Apache 2.0) — two-stage детектор Faster R-CNN.
#
# АРХИТЕКТУРА:
#   Stage 1: ResNet-50 + FPN > RPN (region proposals)
#   Stage 2: RoIAlign > FastRCNNConvFCHead (classification + bbox regression)
#
# ПОЧЕМУ DETECTRON2:
#   - Apache 2.0, коммерчески дружелюбная лицензия.
#   - PyTorch-нативный код, легко модифицировать head/backbone/loss.
#   - Готовые веса COCO для Faster R-CNN и Cascade R-CNN.
#   - Простой ONNX-экспорт через torch.onnx.export.
#
# СОВМЕСТИМОСТЬ ВЕРСИЙ:
#   Detectron2 v0.6 собран под torch 1.10.0 + cu113.
#   Используем pre-built wheel, чтобы не собирать из исходников.
#   OpenCV, pycocotools, onnxruntime — для теста и экспорта.
# =============================================================================

FROM pytorch/pytorch:1.10.0-cuda11.3-cudnn8-devel

# -----------------------------------------------------------------------------
# СИСТЕМНЫЕ ЗАВИСИМОСТИ
#   git, wget — клонирование и скачивание
#   libgl1, libglib2.0-0, libsm6, libxext6 — OpenCV
#   gcc, g++ — для pycocotools
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget libgl1 libglib2.0-0 libsm6 libxext6 libxrender-dev \
    gcc g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# -----------------------------------------------------------------------------
# ФИКСАЦИЯ TORCHVISION ПОД CUDA 11.3
# -----------------------------------------------------------------------------
RUN pip install --no-cache-dir \
    torchvision==0.11.0 torchaudio==0.10.0 \
    --index-url https://download.pytorch.org/whl/cu113

# -----------------------------------------------------------------------------
# DETECTRON2 v0.6 (pre-built wheel для torch1.10.0 + cu113)
#
# ЗАЧЕМ pre-built: сборка из исходников занимает 20-40 минут и требует
#                   точного совпадения TORCH_CUDA_ARCH_LIST с GPU.
#                   Wheel быстрее и стабильнее.
#
# ЧТО ДАЁТ: detectron2.models, detectron2.engine, detectron2.config —
#           всё для тренировки Faster R-CNN на COCO-формате.
# -----------------------------------------------------------------------------
RUN pip install --no-cache-dir detectron2 -f \
    https://dl.fbaipublicfiles.com/detectron2/wheels/cu113/torch1.10/index.html

# -----------------------------------------------------------------------------
# ДОПОЛНИТЕЛЬНЫЕ ЗАВИСИМОСТИ
#   pycocotools — COCOeval для mAP
#   opencv-python-headless — OpenCV без GUI
#   onnx, onnxruntime — экспорт и инференс
#   supervision — confusion matrix
#   matplotlib, seaborn, pandas — графики
# -----------------------------------------------------------------------------
RUN pip install --no-cache-dir \
    pycocotools supervision \
    opencv-python-headless \
    onnx onnxruntime onnxsim \
    matplotlib seaborn pandas scipy

# -----------------------------------------------------------------------------
# ДИРЕКТОРИИ
# -----------------------------------------------------------------------------
RUN mkdir -p /workspace/datasets /workspace/runs /workspace/logs /workspace/logs/plots \
    /workspace/output

# =============================================================================
# СТАДИЯ 0/6: КОНВЕРТАЦИЯ ДАТАСЕТА
#   LabelMe JSON > COCO (Detectron2 работает только с COCO-форматом)
#
# ЧТО ДЕЛАЕТ:
#   Конвертирует LabelMe JSON+JPG в COCO JSON, который Detectron2
#   регистрирует через register_coco_instances().
#
# ЧТО НА ВЫХОДЕ:
#   /workspace/datasets/coco/train/_annotations.coco.json
#   /workspace/datasets/coco/valid/_annotations.coco.json
#   /workspace/datasets/coco/test/_annotations.coco.json
# =============================================================================
COPY <<'PYTHON' /workspace/00_convert.py
"""LabelMe JSON > COCO для Detectron2."""
import os, sys, glob, json, shutil
import cv2
import numpy as np
from sklearn.model_selection import train_test_split

DATASETS_DIR = os.environ.get("DATASETS_DIR", "/workspace/datasets")
COCO_DIR = os.environ.get("COCO_DIR", "/workspace/datasets/coco")
OBJ_NAMES_FILE = os.environ.get("OBJ_NAMES_FILE", "obj.names")
SPLIT_SIZE = float(os.environ.get("SPLIT_SIZE", "0.05"))
RANDOM_STATE = int(os.environ.get("RANDOM_STATE", "42"))


def find_subfolders(root):
    trainval, test = [], []
    for dp, dn, fn in os.walk(root):
        if not any(f.endswith('.json') for f in fn):
            continue
        d = os.path.basename(dp).lower()
        if 'test' in d:
            test.append(dp)
        elif 'trainval' in d or 'train' in d:
            trainval.append(dp)
        else:
            trainval.append(dp)
    return sorted(trainval), sorted(test)


def make_coco_json(json_files, label_list, out_path, img_dir, start_id=0):
    images, annotations = [], []
    ann_id = start_id
    for img_id, fname in enumerate(json_files):
        base = os.path.splitext(os.path.basename(fname))[0]
        src_dir = os.path.dirname(fname)
        jpeg_in = os.path.join(src_dir, base + '.jpg')
        jpeg_out = os.path.join(img_dir, base + '.jpg')
        if os.path.exists(jpeg_in):
            shutil.copy2(jpeg_in, jpeg_out)
        img = cv2.imread(jpeg_out)
        if img is None:
            continue
        h, w = img.shape[:2]

        with open(fname, encoding='utf-8') as f:
            data = json.load(f)

        images.append({
            "id": img_id,
            "file_name": base + '.jpg',
            "width": w,
            "height": h,
        })

        for shape in data.get('shapes', []):
            label = shape['label']
            if label not in label_list:
                continue
            pts = np.array(shape['points']).astype(int)
            x_min, y_min = np.min(pts, axis=0)
            x_max, y_max = np.max(pts, axis=0)
            x_min = max(0, min(x_min, w))
            x_max = max(0, min(x_max, w))
            y_min = max(0, min(y_min, h))
            y_max = max(0, min(y_max, h))
            if x_max <= x_min or y_max <= y_min:
                continue
            annotations.append({
                "id": ann_id,
                "image_id": img_id,
                "category_id": label_list.index(label) + 1,
                "bbox": [int(x_min), int(y_min), int(x_max - x_min), int(y_max - y_min)],
                "area": int((x_max - x_min) * (y_max - y_min)),
                "iscrowd": 0,
            })
            ann_id += 1

    categories = [{"id": i + 1, "name": name} for i, name in enumerate(label_list)]
    coco = {"images": images, "annotations": annotations, "categories": categories}
    with open(out_path, 'w') as f:
        json.dump(coco, f)
    print(f"[OK] {out_path}: {len(images)} images, {len(annotations)} annotations")
    return ann_id


def main():
    for sub in ['train', 'valid', 'test']:
        os.makedirs(os.path.join(COCO_DIR, sub), exist_ok=True)

    paths_trainval, paths_test = find_subfolders(DATASETS_DIR)
    if not paths_trainval and not paths_test:
        print("ERROR: No LabelMe JSON found")
        sys.exit(1)

    obj_candidates = [os.path.join(DATASETS_DIR, OBJ_NAMES_FILE)]
    if paths_trainval:
        obj_candidates.append(os.path.join(paths_trainval[0], OBJ_NAMES_FILE))
    obj_path = next((p for p in obj_candidates if os.path.exists(p)), None)
    if obj_path is None:
        print(f"ERROR: {OBJ_NAMES_FILE} not found")
        sys.exit(1)

    with open(obj_path) as f:
        LABEL_LIST = [l.strip() for l in f if l.strip()]
    print(f"Classes: {LABEL_LIST}")

    trainval_json = []
    for p in paths_trainval:
        trainval_json.extend(sorted(glob.glob(os.path.join(p, '*.json'))))
    test_json = []
    for p in paths_test:
        test_json.extend(sorted(glob.glob(os.path.join(p, '*.json'))))

    if len(trainval_json) > 1:
        train_ids, val_ids = train_test_split(trainval_json, test_size=SPLIT_SIZE,
                                               random_state=RANDOM_STATE)
    else:
        train_ids, val_ids = trainval_json, []

    make_coco_json(train_ids, LABEL_LIST,
                   os.path.join(COCO_DIR, 'train', '_annotations.coco.json'),
                   os.path.join(COCO_DIR, 'train'))
    make_coco_json(val_ids, LABEL_LIST,
                   os.path.join(COCO_DIR, 'valid', '_annotations.coco.json'),
                   os.path.join(COCO_DIR, 'valid'))
    make_coco_json(test_json, LABEL_LIST,
                   os.path.join(COCO_DIR, 'test', '_annotations.coco.json'),
                   os.path.join(COCO_DIR, 'test'))


if __name__ == '__main__':
    main()
PYTHON

