COPY <<'PYTHON' /workspace/04_test_onnx.py
"""ONNX Runtime evaluation for Detectron2 Faster R-CNN."""
import argparse, os, time, pickle, json
import cv2
import numpy as np
import onnxruntime as ort
from pathlib import Path
from pycocotools.coco import COCO
from pycocotools.cocoeval import COCOeval


def preprocess(img, imgsz=640):
    img = cv2.resize(img, (imgsz, imgsz))
    img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB).astype(np.float32)
    mean = np.array([123.675, 116.28, 103.53], dtype=np.float32)
    std = np.array([58.395, 57.12, 57.375], dtype=np.float32)
    img = (img - mean) / std
    return np.expand_dims(img.transpose(2, 0, 1), axis=0)


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--onnx", default=os.environ.get("ONNX_PATH"))
    p.add_argument("--dataset", default=os.path.join(os.environ.get("COCO_DIR", "/workspace/datasets/coco"), "test", "_annotations.coco.json"))
    p.add_argument("--images", default=os.path.join(os.environ.get("COCO_DIR", "/workspace/datasets/coco"), "test"))
    p.add_argument("--log", default="/workspace/logs/04_test_onnx.log")
    args = p.parse_args()

    with open(args.log, "a") as f:
        f.write(f"=== Detectron2 Test (ONNX) ===\nTimestamp: {time.strftime('%Y-%m-%d %H:%M:%S')}\n")
        f.write(f"ONNX: {args.onnx}\n---\n")

    session = ort.InferenceSession(args.onnx, providers=["CUDAExecutionProvider", "CPUExecutionProvider"])
    input_name = session.get_inputs()[0].name

    coco = COCO(args.dataset)
    results, latencies = [], []
    for img_id in coco.getImgIds():
        info = coco.loadImgs(img_id)[0]
        img = cv2.imread(str(Path(args.images) / info["file_name"]))
        if img is None:
            continue
        inp = preprocess(img)
        t0 = time.perf_counter()
        outputs = session.run(None, {input_name: inp})
        t1 = time.perf_counter()
        latencies.append((t1 - t0) * 1000)

        boxes, scores, labels = outputs
        for box, score, label in zip(boxes, scores, labels):
            x1, y1, x2, y2 = box
            if score < 0.05:
                continue
            results.append({
                "image_id": img_id,
                "category_id": int(label) + 1,
                "bbox": [float(x1), float(y1), float(x2 - x1), float(y2 - y1)],
                "score": float(score),
            })

    if not results:
        with open(args.log, "a") as f:
            f.write("WARN: no detections\n")
        return

    coco_dt = coco.loadRes(results)
    ev = COCOeval(coco, coco_dt, "bbox")
    ev.evaluate(); ev.accumulate(); ev.summarize()

    with open(args.log, "a") as f:
        f.write(f"mAP@0.5: {ev.stats[1]:.4f}\n")
        f.write(f"mAP@0.5:0.95: {ev.stats[0]:.4f}\n")
        f.write(f"Avg latency: {sum(latencies)/len(latencies):.2f} ms\n")

    with open("/workspace/logs/plots/coco_eval.pkl", "wb") as f:
        pickle.dump({"coco_eval": ev, "results": results}, f)


if __name__ == "__main__":
    main()
PYTHON

