"""Detectron2 Faster R-CNN > ONNX (через tracing)."""
import os, time, torch
from detectron2.config import get_cfg
from detectron2 import model_zoo
from detectron2.modeling import build_model

COCO_DIR = os.environ.get("COCO_DIR", "/workspace/datasets/coco")
NUM_CLASSES = int(os.environ.get("NUM_CLASSES", "3"))
MODEL = os.environ.get("MODEL_CFG", "COCO-Detection/faster_rcnn_R_50_FPN_3x.yaml")
WEIGHTS = os.environ.get("WEIGHTS", "/workspace/output/model_final.pth")
ONNX_PATH = os.environ.get("ONNX_PATH", "/workspace/runs/onnx/model.onnx")
IMG_SIZE = int(os.environ.get("IMG_SIZE", "640"))

os.makedirs(os.path.dirname(ONNX_PATH), exist_ok=True)

with open("/workspace/logs/03_export.log", "a") as f:
    f.write(f"=== Detectron2 ONNX Export ===\nTimestamp: {time.strftime('%Y-%m-%d %H:%M:%S')}\n")

cfg = get_cfg()
cfg.merge_from_file(model_zoo.get_config_file(MODEL))
cfg.MODEL.WEIGHTS = WEIGHTS
cfg.MODEL.ROI_HEADS.NUM_CLASSES = NUM_CLASSES

model = build_model(cfg)
model.eval()
model.to("cuda")

# Detectron2 Faster R-CNN returns list of dicts. ONNX tracing requires tensor output.
# Use torch.onnx.export with a wrapper that returns tensors.
class Wrapper(torch.nn.Module):
    def __init__(self, model):
        super().__init__()
        self.model = model
    def forward(self, x):
        outputs = self.model([{"image": x[0]}])
        out = outputs[0]
        return out["instances"].pred_boxes.tensor, out["instances"].scores, out["instances"].pred_classes

dummy = torch.randn(1, 3, IMG_SIZE, IMG_SIZE).cuda()
wrapper = Wrapper(model).cuda()

torch.onnx.export(
    wrapper, dummy, ONNX_PATH,
    input_names=["input"],
    output_names=["boxes", "scores", "labels"],
    opset_version=13,
    dynamic_axes={"input": {2: "h", 3: "w"}},
)

with open("/workspace/logs/03_export.log", "a") as f:
    f.write(f"ONNX exported: {ONNX_PATH}\n")
PYTHON

