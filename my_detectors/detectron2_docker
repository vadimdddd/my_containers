"""Detectron2 Faster R-CNN training."""
import os, time
from detectron2.engine import DefaultTrainer
from detectron2.config import get_cfg
from detectron2 import model_zoo
from detectron2.data.datasets import register_coco_instances

COCO_DIR = os.environ.get("COCO_DIR", "/workspace/datasets/coco")
OUTPUT_DIR = os.environ.get("OUTPUT_DIR", "/workspace/output")
NUM_CLASSES = int(os.environ.get("NUM_CLASSES", "3"))
EPOCHS = int(os.environ.get("EPOCHS", "12"))
BATCH = int(os.environ.get("BATCH", "2"))
BASE_LR = float(os.environ.get("BASE_LR", "0.00025"))
MODEL = os.environ.get("MODEL_CFG", "COCO-Detection/faster_rcnn_R_50_FPN_3x.yaml")

with open("/workspace/logs/01_train.log", "a") as f:
    f.write(f"=== Detectron2 Training ===\nTimestamp: {time.strftime('%Y-%m-%d %H:%M:%S')}\n")
    f.write(f"Model: {MODEL}\nNum classes: {NUM_CLASSES}\nEpochs: {EPOCHS}\n---\n")

register_coco_instances("mydata_train", {},
                        os.path.join(COCO_DIR, "train", "_annotations.coco.json"),
                        os.path.join(COCO_DIR, "train"))
register_coco_instances("mydata_valid", {},
                        os.path.join(COCO_DIR, "valid", "_annotations.coco.json"),
                        os.path.join(COCO_DIR, "valid"))

cfg = get_cfg()
cfg.merge_from_file(model_zoo.get_config_file(MODEL))
cfg.DATASETS.TRAIN = ("mydata_train",)
cfg.DATASETS.TEST = ("mydata_valid",)
cfg.DATALOADER.NUM_WORKERS = int(os.environ.get("WORKERS", "2"))
cfg.MODEL.WEIGHTS = model_zoo.get_checkpoint_url(MODEL)
cfg.SOLVER.IMS_PER_BATCH = BATCH
cfg.SOLVER.BASE_LR = BASE_LR
# 1 epoch = len(train) / batch iterations. Detectron2 uses iterations.
# Approximate: 12 epochs for ~5000 images ~ 30000 iters. Scale by data size.
cfg.SOLVER.MAX_ITER = int(os.environ.get("MAX_ITER", "30000"))
cfg.SOLVER.STEPS = (int(cfg.SOLVER.MAX_ITER * 0.67), int(cfg.SOLVER.MAX_ITER * 0.89))
cfg.MODEL.ROI_HEADS.BATCH_SIZE_PER_IMAGE = 512
cfg.MODEL.ROI_HEADS.NUM_CLASSES = NUM_CLASSES
cfg.OUTPUT_DIR = OUTPUT_DIR
os.makedirs(OUTPUT_DIR, exist_ok=True)

trainer = DefaultTrainer(cfg)
trainer.resume_or_load(resume=False)
trainer.train()

with open("/workspace/logs/01_train.log", "a") as f:
    f.write("Training complete.\n")
