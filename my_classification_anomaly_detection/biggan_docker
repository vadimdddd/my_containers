FROM pytorch/pytorch:2.6.0-cuda12.6-cudnn9-devel

RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget libgl1 libglib2.0-0 \
    gcc g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

RUN pip install --no-cache-dir \
    torch==2.6.0 torchvision==0.21.0 \
    --index-url https://download.pytorch.org/whl/cu126

# BigGAN ˜ÂÂÁ MMagic ó ÂÒÚ¸ „ÓÚÓ‚˚Â ‚ÂÒ‡ Ë ÍÓÌÙË„Ë
RUN pip install --no-cache-dir \
    openmim \
    && mim install mmengine \
    && mim install 'mmcv>=2.0.0' \
    && pip install --no-cache-dir mmagic

RUN pip install --no-cache-dir \
    opencv-python-headless \
    matplotlib seaborn pandas scipy \
    Pillow tqdm

RUN mkdir -p /workspace/runs /workspace/logs /workspace/logs/plots

# =============================================================================
# »Õ‘≈–≈Õ—: BigGAN class-conditional generation
# =============================================================================
COPY <<'PYTHON' /workspace/generate.py
"""
BigGAN inference: class-conditional generation.
"""
import os, time, argparse
from mmagic.apis import MMagicInferencer

def main():
    p = argparse.ArgumentParser()
    p.add_argument("--class-id", type=int, default=207,
                   help="ImageNet class id (207 = golden retriever)")
    p.add_argument("--num-images", type=int, default=4)
    p.add_argument("--output", default="/workspace/runs/biggan_output")
    p.add_argument("--log", default="/workspace/logs/biggan.log")
    args = p.parse_args()

    os.makedirs(args.output, exist_ok=True)

    with open(args.log, "a") as f:
        f.write(f"=== BigGAN Inference ===\n")
        f.write(f"Timestamp: {time.strftime('%Y-%m-%d %H:%M:%S')}\n")
        f.write(f"Class ID: {args.class_id}\n")

    inferencer = MMagicInferencer(model_name="biggan")
    result = inferencer.infer(
        label=args.class_id,
        num_images=args.num_images,
        result_out_dir=args.output,
    )

    with open(args.log, "a") as f:
        f.write(f"Generated {args.num_images} images to {args.output}\n")

    print(f"Generated: {args.output}")

if __name__ == "__main__":
    main()
PYTHON

ENTRYPOINT ["/bin/bash"]