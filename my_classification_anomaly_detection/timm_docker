COPY <<'PYTHON' /workspace/00_convert.py
"""
LabelMe JSON > папки классов для timm.

ФОРМАТ:
  datasets/
    +-- train/
    ¦   +-- class_0/*.jpg
    ¦   +-- class_1/*.jpg
    ¦   L-- ...
    L-- val/
        +-- class_0/*.jpg
        L-- ...
"""
import os, sys, glob, json, shutil
from sklearn.model_selection import train_test_split

DATASETS_DIR = os.environ.get("DATASETS_DIR", "/workspace/datasets")
OUT_DIR = os.environ.get("TIMM_DATA_DIR", "/workspace/timm_data")
OBJ_NAMES_FILE = os.environ.get("OBJ_NAMES_FILE", "obj.names")
SPLIT_SIZE = float(os.environ.get("SPLIT_SIZE", "0.2"))
RANDOM_STATE = int(os.environ.get("RANDOM_STATE", "42"))

def find_subfolders(root):
    trainval, test = [], []
    for dp, dn, fn in os.walk(root):
        if not any(f.endswith('.json') for f in fn):
            continue
        d = os.path.basename(dp).lower()
        if 'test' in d:
            test.append(dp)
        else:
            trainval.append(dp)
    return sorted(trainval), sorted(test)

def get_label_from_json(json_path, label_list):
    with open(json_path, encoding='utf-8') as f:
        data = json.load(f)
    labels = set()
    for shape in data.get('shapes', []):
        if shape['label'] in label_list:
            labels.add(shape['label'])
    return list(labels)

def main():
    obj_path = os.path.join(DATASETS_DIR, OBJ_NAMES_FILE)
    with open(obj_path) as f:
        LABEL_LIST = [l.strip() for l in f if l.strip()]
    print(f"Classes: {LABEL_LIST}")

    paths_trainval, paths_test = find_subfolders(DATASETS_DIR)

    all_samples = []  # (json_path, label)
    for p in paths_trainval:
        for jp in sorted(glob.glob(os.path.join(p, '*.json'))):
            labels = get_label_from_json(jp, LABEL_LIST)
            # Берем первый класс (для multi-label нужна другая логика)
            if labels:
                all_samples.append((jp, labels[0]))

    train_samples, val_samples = train_test_split(
        all_samples, test_size=SPLIT_SIZE, random_state=RANDOM_STATE,
        stratify=[s[1] for s in all_samples] if len(set(s[1] for s in all_samples)) > 1 else None
    )

    for split_name, samples in [('train', train_samples), ('val', val_samples)]:
        for jp, label in samples:
            base = os.path.splitext(os.path.basename(jp))[0]
            src_dir = os.path.dirname(jp)
            jpg = os.path.join(src_dir, base + '.jpg')
            if not os.path.exists(jpg):
                continue
            dst_dir = os.path.join(OUT_DIR, split_name, label)
            os.makedirs(dst_dir, exist_ok=True)
            shutil.copy2(jpg, os.path.join(dst_dir, base + '.jpg'))

    print(f"Train: {len(train_samples)}, Val: {len(val_samples)}")
    print(f"Data ready at: {OUT_DIR}")

if __name__ == '__main__':
    main()
PYTHON

