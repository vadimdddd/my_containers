COPY <<'PYTHON' /workspace/04_test_onnx.py
"""ONNX evaluation for semantic segmentation."""
import argparse, os, time, pickle
import cv2
import numpy as np
import onnxruntime as ort
from pathlib import Path

def preprocess(img, imgsz=(512, 1024)):
    img = cv2.resize(img, imgsz)
    img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB).astype(np.float32)
    mean = np.array([123.675, 116.28, 103.53], dtype=np.float32)
    std = np.array([58.395, 57.12, 57.375], dtype=np.float32)
    img = (img - mean) / std
    return np.expand_dims(img.transpose(2, 0, 1), axis=0)

def compute_miou(preds, gts, num_classes):
    ious = []
    for c in range(1, num_classes + 1):
        pred_c = (preds == c)
        gt_c = (gts == c)
        inter = (pred_c & gt_c).sum()
        union = (pred_c | gt_c).sum()
        if union > 0:
            ious.append(inter / union)
    return np.mean(ious) if ious else 0.0

def main():
    p = argparse.ArgumentParser()
    p.add_argument("--onnx", default=os.environ.get("ONNX_PATH"))
    p.add_argument("--images", default="/workspace/mmsegmentation/data/nlmk_seg/img_dir/test")
    p.add_argument("--masks", default="/workspace/mmsegmentation/data/nlmk_seg/ann_dir/test")
    p.add_argument("--log", default="/workspace/logs/04_test_onnx.log")
    args = p.parse_args()

    with open(args.log, "a") as f:
        f.write(f"=== U-Net Test (ONNX) ===\nTimestamp: {time.strftime('%Y-%m-%d %H:%M:%S')}\n")

    session = ort.InferenceSession(args.onnx, providers=["CUDAExecutionProvider", "CPUExecutionProvider"])
    input_name = session.get_inputs()[0].name

    ious, latencies = [], []
    for img_path in sorted(Path(args.images).glob("*.jpg")):
        mask_path = Path(args.masks) / (img_path.stem + ".png")
        if not mask_path.exists():
            continue
        img = cv2.imread(str(img_path))
        gt = cv2.imread(str(mask_path), cv2.IMREAD_GRAYSCALE)
        if img is None or gt is None:
            continue
        inp = preprocess(img)
        t0 = time.perf_counter()
        outputs = session.run(None, {input_name: inp})
        t1 = time.perf_counter()
        latencies.append((t1 - t0) * 1000)
        pred = np.argmax(outputs[0][0], axis=0)
        pred = cv2.resize(pred.astype(np.uint8), (gt.shape[1], gt.shape[0]),
                          interpolation=cv2.INTER_NEAREST)
        ious.append(compute_miou(pred, gt, int(os.environ.get("NUM_CLASSES", "3"))))

    miou = np.mean(ious) if ious else 0.0
    with open(args.log, "a") as f:
        f.write(f"mIoU: {miou:.4f}\n")
        f.write(f"Avg latency: {sum(latencies)/len(latencies):.2f} ms\n")

if __name__ == "__main__":
    main()
PYTHON

