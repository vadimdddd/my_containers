# =============================================================================
# unet_docker.dockerfile
# U-Net (Apache 2.0, MMSegmentation v0.30.0) — semantic segmentation.
#
# АРХИТЕКТУРА:
#   Encoder-decoder с skip connections. Классическая U-образная форма.
#
# ПОЧЕМУ U-Net:
#   - Лёгкая (17.91 GB памяти для обучения на Cityscapes)
#   - Хороша для медицинских и промышленных задач с малым числом классов
#   - Готовая реализация в MMSegmentation: configs/unet/
#   - fcn_unet_s5-d16_4x4_512x1024_160k_cityscapes — базовая конфигурация [citation:32]
#
# СОВМЕСТИМОСТЬ ВЕРСИЙ:
#   MMSegmentation v0.30.0 + mmcv-full 1.7.0 + torch 1.10.0 + cu113.
# =============================================================================

FROM pytorch/pytorch:1.10.0-cuda11.3-cudnn8-devel

RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget libgl1 libglib2.0-0 libsm6 libxext6 libxrender-dev \
    gcc g++ ninja-build \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

RUN pip install --no-cache-dir \
    torchvision==0.11.0 torchaudio==0.10.0 \
    --index-url https://download.pytorch.org/whl/cu113

RUN pip install --no-cache-dir \
    mmcv-full==1.7.0 \
    -f https://download.openmmlab.com/mmcv/dist/cu113/torch1.10.0/index.html

RUN git clone -b 'v0.30.0' https://github.com/open-mmlab/mmsegmentation.git . \
    && pip install --no-cache-dir -v -e .

RUN pip install --no-cache-dir mmdet==2.27.0

RUN pip install --no-cache-dir pybind11 onnxruntime onnx onnxsim \
    && git clone -b 'v0.12.0' https://github.com/open-mmlab/mmdeploy.git /workspace/mmdeploy \
    && cd /workspace/mmdeploy && pip install --no-cache-dir -v -e .

RUN pip install --no-cache-dir \
    scikit-learn lxml \
    pycocotools supervision \
    opencv-python-headless \
    matplotlib seaborn pandas scipy

RUN mkdir -p /workspace/datasets /workspace/runs /workspace/logs /workspace/logs/plots \
    /workspace/mmsegmentation/data /workspace/work_dirs

COPY <<'PYTHON' /workspace/00_convert.py
"""LabelMe JSON > PNG masks для MMSegmentation."""
import os, sys, glob, json, shutil
import cv2
import numpy as np
from sklearn.model_selection import train_test_split

DATASETS_DIR = os.environ.get("DATASETS_DIR", "/workspace/datasets")
OUT_DIR = os.environ.get("MMSEG_DATA_DIR", "/workspace/mmsegmentation/data/nlmk_seg")
OBJ_NAMES_FILE = os.environ.get("OBJ_NAMES_FILE", "obj.names")
SPLIT_SIZE = float(os.environ.get("SPLIT_SIZE", "0.05"))
RANDOM_STATE = int(os.environ.get("RANDOM_STATE", "42"))

def make_masks(json_files, label_list, img_dir, ann_dir):
    os.makedirs(img_dir, exist_ok=True)
    os.makedirs(ann_dir, exist_ok=True)
    for fname in json_files:
        base = os.path.splitext(os.path.basename(fname))[0]
        src_dir = os.path.dirname(fname)
        jpeg_in = os.path.join(src_dir, base + '.jpg')
        jpeg_out = os.path.join(img_dir, base + '.jpg')
        if os.path.exists(jpeg_in):
            shutil.copy2(jpeg_in, jpeg_out)
        img = cv2.imread(jpeg_out)
        if img is None:
            continue
        h, w = img.shape[:2]
        mask = np.zeros((h, w), dtype=np.uint8)
        with open(fname, encoding='utf-8') as f:
            data = json.load(f)
        for shape in data.get('shapes', []):
            label = shape['label']
            if label not in label_list:
                continue
            cls_id = label_list.index(label) + 1
            pts = np.array(shape['points']).astype(np.int32)
            cv2.fillPoly(mask, [pts], cls_id)
        cv2.imwrite(os.path.join(ann_dir, base + '.png'), mask)
    print(f"[OK] {len(json_files)} images > {img_dir}")

def find_subfolders(root):
    trainval, test = [], []
    for dp, dn, fn in os.walk(root):
        if not any(f.endswith('.json') for f in fn):
            continue
        d = os.path.basename(dp).lower()
        if 'test' in d:
            test.append(dp)
        else:
            trainval.append(dp)
    return sorted(trainval), sorted(test)

def main():
    paths_trainval, paths_test = find_subfolders(DATASETS_DIR)
    obj_path = os.path.join(DATASETS_DIR, OBJ_NAMES_FILE)
    if not os.path.exists(obj_path) and paths_trainval:
        obj_path = os.path.join(paths_trainval[0], OBJ_NAMES_FILE)
    with open(obj_path) as f:
        LABEL_LIST = [l.strip() for l in f if l.strip()]
    print(f"Classes: {LABEL_LIST}")

    trainval_json = []
    for p in paths_trainval:
        trainval_json.extend(sorted(glob.glob(os.path.join(p, '*.json'))))
    test_json = []
    for p in paths_test:
        test_json.extend(sorted(glob.glob(os.path.join(p, '*.json'))))

    train_ids, val_ids = train_test_split(trainval_json, test_size=SPLIT_SIZE,
                                           random_state=RANDOM_STATE)
    make_masks(train_ids, LABEL_LIST,
               os.path.join(OUT_DIR, 'img_dir', 'train'),
               os.path.join(OUT_DIR, 'ann_dir', 'train'))
    make_masks(val_ids, LABEL_LIST,
               os.path.join(OUT_DIR, 'img_dir', 'val'),
               os.path.join(OUT_DIR, 'ann_dir', 'val'))
    make_masks(test_json, LABEL_LIST,
               os.path.join(OUT_DIR, 'img_dir', 'test'),
               os.path.join(OUT_DIR, 'ann_dir', 'test'))
    print(f"Train: {len(train_ids)}, Val: {len(val_ids)}, Test: {len(test_json)}")

if __name__ == '__main__':
    main()
PYTHON

