# =============================================================================
# lightonocr_docker.dockerfile
# LightOnOCR-2-1B (Apache 2.0) — end-to-end OCR VLM.
#
# НАЗНАЧЕНИЕ:
#   - Инференс на готовых весах (документы, сканы, таблицы).
#   - LoRA/QLoRA файн-тюнинг на кастомных данных (адаптация под язык/домен).
#
# ВАЖНО:
#   Это НЕ пайплайн "convert > train > test > export" в том же смысле,
#   что для CRNN (MMOCR). LightOnOCR — это VLM, а не лёгкий распознаватель.
#   Файн-тюнинг требует 24GB+ VRAM и делается через LoRA.
#
# ЛИЦЕНЗИЯ:
#   Веса модели: Apache 2.0 [citation:1][citation:2][citation:7].
# =============================================================================

FROM pytorch/pytorch:2.6.0-cuda12.6-cudnn9-devel

RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget libgl1 libglib2.0-0 libsm6 libxext6 libxrender-dev \
    gcc g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Установка transformers из исходников (требуется для LightOnOcrForConditionalGeneration)
RUN pip install --no-cache-dir \
    torch==2.6.0 torchvision==0.21.0 torchaudio==2.6.0 \
    --index-url https://download.pytorch.org/whl/cu126

RUN pip install --no-cache-dir \
    "transformers>=5.0.0" \
    accelerate \
    peft \
    bitsandbytes \
    datasets \
    Pillow \
    opencv-python-headless \
    matplotlib seaborn pandas scipy

# Установка зависимостей для генерации из исходников
RUN pip install --no-cache-dir \
    git+https://github.com/huggingface/transformers.git

RUN mkdir -p /workspace/datasets /workspace/runs /workspace/logs /workspace/logs/plots

# =============================================================================
# ИНФЕРЕНС: LightOnOCR-2-1B
# =============================================================================
COPY <<'PYTHON' /workspace/inference.py
"""
Инференс LightOnOCR-2-1B на изображениях.
"""
import os, time, argparse
import torch
from transformers import LightOnOcrForConditionalGeneration, LightOnOcrProcessor
from PIL import Image

LONGEST_EDGE = 1540
BASE_MODEL_ID = "lightonai/LightOnOCR-2-1B"

def main():
    p = argparse.ArgumentParser()
    p.add_argument("--image", required=True, help="Path to image or PDF")
    p.add_argument("--log", default="/workspace/logs/inference.log")
    args = p.parse_args()

    with open(args.log, "a") as f:
        f.write(f"=== LightOnOCR Inference ===\nTimestamp: {time.strftime('%Y-%m-%d %H:%M:%S')}\n")

    processor = LightOnOcrProcessor.from_pretrained(BASE_MODEL_ID)
    processor.tokenizer.padding_side = "left"

    model = LightOnOcrForConditionalGeneration.from_pretrained(
        BASE_MODEL_ID,
        device_map="auto",
        torch_dtype=torch.bfloat16,
    )
    model.eval()

    image = Image.open(args.image).convert("RGB")

    messages = [
        {"role": "user", "content": [{"type": "image"}]},
    ]

    text = processor.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)
    inputs = processor(
        text=text,
        images=[image],
        return_tensors="pt",
        size={"longest_edge": LONGEST_EDGE},
    ).to(model.device)

    with torch.no_grad():
        generated_ids = model.generate(
            **inputs,
            max_new_tokens=4096,
            do_sample=False,
        )

    result = processor.batch_decode(generated_ids, skip_special_tokens=True)[0]

    with open(args.log, "a") as f:
        f.write(f"Image: {args.image}\n")
        f.write(f"Result:\n{result}\n")

    print(result)

if __name__ == "__main__":
    main()
PYTHON

