# =============================================================================
# mmocr_docker.dockerfile
# MMOCR v0.6.3 (Apache 2.0) — модульный OCR-конструктор.
#
# НАЗНАЧЕНИЕ:
#   - Традиционный OCR: детекция + распознавание.
#   - CRNN, SAR, SEG и другие распознаватели.
#   - Модульность: backbone + neck + head.
#
# ЛИЦЕНЗИЯ:
#   Apache 2.0.
# =============================================================================

FROM pytorch/pytorch:1.10.0-cuda11.3-cudnn8-devel

RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget libgl1 libglib2.0-0 libsm6 libxext6 libxrender-dev \
    gcc g++ ninja-build \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Фиксация torchvision
RUN pip install --no-cache-dir \
    torchvision==0.11.0 torchaudio==0.10.0 \
    --index-url https://download.pytorch.org/whl/cu113

# MMOCR v0.6.3
RUN git clone -b 'v0.6.3' https://github.com/open-mmlab/mmocr.git . \
    && pip install --no-cache-dir -v -e .

# MMDetection v2.27.0
RUN git clone -b 'v2.27.0' https://github.com/open-mmlab/mmdetection.git /workspace/mmdetection \
    && cd /workspace/mmdetection && pip install --no-cache-dir -v -e .

# mmcv-full 1.7.0
RUN pip install --no-cache-dir \
    mmcv-full==1.7.0 \
    -f https://download.openmmlab.com/mmcv/dist/cu113/torch1.10.0/index.html

# mmdeploy v0.12.0
RUN pip install --no-cache-dir pybind11 onnxruntime onnx onnxsim \
    && git clone -b 'v0.12.0' https://github.com/open-mmlab/mmdeploy.git /workspace/mmdeploy \
    && cd /workspace/mmdeploy && pip install --no-cache-dir -v -e .

# Дополнительные зависимости
RUN pip install --no-cache-dir \
    opencv-python-headless \
    matplotlib seaborn pandas scipy \
    pycocotools

RUN mkdir -p /workspace/datasets /workspace/runs /workspace/logs /workspace/logs/plots \
    /workspace/work_dirs

# =============================================================================
# СТАДИЯ 0: КОНВЕРТАЦИЯ ДАТАСЕТА
#   LabelMe JSON > MMOCR формат (детекция + распознавание)
# =============================================================================
COPY <<'PYTHON' /workspace/00_convert.py
"""
LabelMe JSON > MMOCR формат.

Для детекции: images + labelme-json или icdar txt.
Для распознавания: crop-изображения + аннотации.
"""
import os, sys, glob, json, shutil
import cv2
import numpy as np

DATASETS_DIR = os.environ.get("DATASETS_DIR", "/workspace/datasets")
OUT_DIR = os.environ.get("MMOCR_DATA_DIR", "/workspace/mmocr_data")

def main():
    det_dir = os.path.join(OUT_DIR, "det")
    rec_dir = os.path.join(OUT_DIR, "rec")
    os.makedirs(os.path.join(det_dir, "images"), exist_ok=True)
    os.makedirs(os.path.join(det_dir, "annotations"), exist_ok=True)
    os.makedirs(os.path.join(rec_dir, "images"), exist_ok=True)

    json_files = []
    for dp, dn, fn in os.walk(DATASETS_DIR):
        if any(f.endswith('.json') for f in fn):
            json_files.extend(sorted(glob.glob(os.path.join(dp, '*.json'))))

    with open("/workspace/logs/00_convert.log", "a") as log:
        log.write(f"Found {len(json_files)} JSON files\n")

    for fname in json_files:
        base = os.path.splitext(os.path.basename(fname))[0]
        src_dir = os.path.dirname(fname)
        jpeg_in = os.path.join(src_dir, base + '.jpg')
        jpeg_out = os.path.join(det_dir, "images", base + '.jpg')
        if os.path.exists(jpeg_in):
            shutil.copy2(jpeg_in, jpeg_out)

        img = cv2.imread(jpeg_out)
        if img is None:
            continue
        h, w = img.shape[:2]

        with open(fname, encoding='utf-8') as f:
            data = json.load(f)

        # Для детекции: MMOCR принимает labelme JSON
        # Копируем JSON в annotations
        shutil.copy2(fname, os.path.join(det_dir, "annotations", base + '.json'))

    print(f"[OK] Detection data: {det_dir}")
    print(f"[OK] Recognition data: {rec_dir}")

if __name__ == '__main__':
    main()
PYTHON

# =============================================================================
# СТАДИЯ 1: ТРЕНИРОВКА
# =============================================================================
COPY <<'SHELL' /workspace/01_train.sh
#!/bin/bash
set -e
LOG_FILE=${LOG_FILE:-/workspace/logs/01_train.log}
{
echo "=== MMOCR Training ==="
echo "Timestamp: $(date)"
echo "Config: ${CONFIG:-configs/textrecog/crnn/crnn_academic_dataset.py}"
echo "---"

python tools/train.py ${CONFIG:-configs/textrecog/crnn/crnn_academic_dataset.py} \
    --gpu-id 0 --work-dir /workspace/work_dirs/${RUN_NAME:-crnn}
} 2>&1 | tee $LOG_FILE
SHELL
RUN chmod +x /workspace/01_train.sh

# =============================================================================
# СТАДИЯ 2: ТЕСТ
# =============================================================================
COPY <<'SHELL' /workspace/02_test.sh
#!/bin/bash
set -e
LOG_FILE=${LOG_FILE:-/workspace/logs/02_test.log}
{
echo "=== MMOCR Test ==="
python tools/test.py ${CONFIG} ${CHECKPOINT} --eval acc --gpu-id 0
} 2>&1 | tee $LOG_FILE
SHELL
RUN chmod +x /workspace/02_test.sh

COPY <<'SHELL' /workspace/pipeline.sh
#!/bin/bash
set -e
MASTER_LOG=/workspace/logs/00_pipeline.log
mkdir -p /workspace/logs /workspace/logs/plots
log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [PIPELINE] $1" | tee -a $MASTER_LOG; }
trap 'log "FAILED at step ${CURRENT_STEP} (exit=$?)"; exit 1' ERR

log "MMOCR Pipeline START"
CURRENT_STEP="0/4 CONVERT"; log "STEP 0/4: Converting LabelMe > MMOCR format"
python /workspace/00_convert.py 2>&1 | tee -a /workspace/logs/00_convert.log

CURRENT_STEP="1/4 TRAIN"; log "STEP 1/4: Training"
bash /workspace/01_train.sh

CURRENT_STEP="2/4 TEST"; log "STEP 2/4: Testing"
bash /workspace/02_test.sh

log "Pipeline COMPLETE"
SHELL
RUN chmod +x /workspace/pipeline.sh

ENTRYPOINT ["/workspace/pipeline.sh"]